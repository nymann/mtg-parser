  ~ ^"power" ~ unsigned_number ~ ^"or" ~ ^"greater" ~ "."
}

static_named_source_pt_equal_to_count = {
    possessive_proper_name ~ ^"'s" ~ ^"power" ~ ^"and" ~ ^"toughness"
  ~ ^"are" ~ ^"each" ~ ^"equal" ~ ^"to" ~ ^"the" ~ ^"number" ~ ^"of"
  ~ named_source_pt_count ~ "."
}
named_source_pt_count = _{
    non_creature_type_creatures_you_control
  | basic_lands_you_control
  | creatures_named_on_battlefield
}
non_creature_type_creatures_you_control = {
    ^"non-" ~ creature_type ~ ^"creatures" ~ ^"you" ~ ^"control"
}
basic_lands_you_control = { basic_land_type_plural ~ ^"you" ~ ^"control" }
creatures_named_on_battlefield = {
    ^"creatures" ~ ^"named" ~ proper_name ~ ^"on" ~ ^"the" ~ ^"battlefield"
}

possessive_proper_name = @{ upper_alpha ~ (!("'s" ~ WHITESPACE) ~ ANY)* }

target_creature_defending_player_controls_can_block_any_number = {
    blocking_capacity_subject ~ ^"can" ~ ^"block" ~ blocking_capacity_amount
  ~ blocking_capacity_object ~ blocking_capacity_duration ~ "."
}
blocking_capacity_subject = {
    (^"target" ~ ^"creature" ~ ^"defending" ~ ^"player" ~ ^"controls")
  | source_object
}
blocking_capacity_amount = { blocking_capacity_any_number | blocking_capacity_additional_one }
blocking_capacity_any_number = { ^"any" ~ ^"number" ~ ^"of" }
blocking_capacity_additional_one = { article ~ ^"additional" }
blocking_capacity_object = { ^"creatures" | ^"creature" }
blocking_capacity_duration = { blocking_capacity_this_turn | blocking_capacity_each_combat }
blocking_capacity_this_turn = { ^"this" ~ ^"turn" }
blocking_capacity_each_combat = { ^"each" ~ ^"combat" }

remove_target_creature_defending_player_controls_from_combat = {
    ^"remove" ~ ^"target" ~ ^"creature" ~ ^"defending" ~ ^"player"
  ~ ^"controls" ~ ^"from" ~ ^"combat" ~ "."
}

creatures_it_was_blocking_become_unblocked = {
    ^"creatures" ~ ^"it" ~ ^"was" ~ ^"blocking" ~ ^"that" ~ ^"had"
  ~ ^"become" ~ ^"blocked" ~ ^"by" ~ ^"only" ~ ^"that" ~ ^"creature"
  ~ ^"this" ~ ^"combat" ~ ^"become" ~ ^"unblocked" ~ "."
}

you_may_have_it_block_attacking_creature = {
    ^"you" ~ ^"may" ~ ^"have" ~ ^"it" ~ ^"block" ~ article
  ~ ^"attacking" ~ ^"creature" ~ ^"of" ~ ^"your" ~ ^"choice" ~ "."
}

creatures_attack_this_turn_if_able = {
    attack_requirement_subject ~ attack_requirement_verb ~ ^"this" ~ ^"turn"
  ~ ^"if" ~ ^"able" ~ "."
}
attack_requirement_verb = _{ ^"attacks" | ^"attack" }
attack_requirement_subject = _{ that_creature_subject | creatures_active_player_controls_subject }
that_creature_subject = { ^"that" ~ ^"creature" }
creatures_active_player_controls_subject = {
    ^"creatures" ~ ^"the" ~ ^"active" ~ ^"player" ~ ^"controls"
}

it_blocks_each_attacking_creature_if_able = {
    ^"it" ~ ^"blocks" ~ ^"each" ~ ^"attacking" ~ ^"creature"
  ~ ^"this" ~ ^"turn" ~ ^"if" ~ ^"able" ~ "."
}

ignore_this_effect_for_each_creature_player_didnt_control_continuously = {
    ^"ignore" ~ ^"this" ~ ^"effect" ~ ^"for" ~ ^"each" ~ ^"creature"
  ~ ^"the" ~ ^"player" ~ ^"didn't" ~ ^"control" ~ ^"continuously"
  ~ ^"since" ~ ^"the" ~ ^"beginning" ~ ^"of" ~ ^"the" ~ ^"turn" ~ "."
}

this_turn_defending_players_make_random_blocking_piles = {
    ^"this" ~ ^"turn" ~ "," ~ ^"instead" ~ ^"of" ~ ^"declaring" ~ ^"blockers"
  ~ "," ~ ^"each" ~ ^"defending" ~ ^"player" ~ ^"chooses" ~ ^"any"
  ~ ^"number" ~ ^"of" ~ ^"creatures" ~ ^"they" ~ ^"control" ~ ^"and"
  ~ ^"divides" ~ ^"them" ~ ^"into" ~ article ~ ^"number" ~ ^"of"
  ~ ^"piles" ~ ^"equal" ~ ^"to" ~ ^"the" ~ ^"number" ~ ^"of"
  ~ ^"attacking" ~ ^"creatures" ~ ^"for" ~ ^"whom" ~ ^"that"
  ~ ^"player" ~ ^"is" ~ ^"the" ~ ^"defending" ~ ^"player" ~ "."
}

additional_blockers_may_be_put_into_additional_piles = {
    ^"creatures" ~ ^"those" ~ ^"players" ~ ^"control" ~ ^"that"
  ~ ^"can" ~ ^"block" ~ ^"additional" ~ ^"creatures" ~ ^"may"
  ~ ^"likewise" ~ ^"be" ~ ^"put" ~ ^"into" ~ ^"additional" ~ ^"piles" ~ "."
}

assign_each_pile_to_attacking_creature_at_random = {
    ^"assign" ~ ^"each" ~ ^"pile" ~ ^"to" ~ article ~ ^"different"
  ~ ^"one" ~ ^"of" ~ ^"those" ~ ^"attacking" ~ ^"creatures"
  ~ ^"at" ~ ^"random" ~ "."
}

creatures_in_assigned_pile_block_if_able = {
    ^"each" ~ ^"creature" ~ ^"in" ~ article ~ ^"pile" ~ ^"that"
  ~ ^"can" ~ ^"block" ~ ^"the" ~ ^"creature" ~ ^"that" ~ ^"pile"
  ~ ^"is" ~ ^"assigned" ~ ^"to" ~ ^"does" ~ ^"so" ~ "."
}

then_for_each_attacking_creature_choose_label_blocking_restriction = {
    ^"then" ~ "," ~ ^"for" ~ ^"each" ~ ^"attacking" ~ ^"creature"
  ~ ^"you" ~ ^"control" ~ "," ~ ^"choose" ~ quoted_label
  ~ ^"or" ~ quoted_label_with_inner_period ~ ^"that" ~ ^"creature"
  ~ ^"can't" ~ ^"be" ~ ^"blocked" ~ ^"this" ~ ^"combat" ~ ^"except"
  ~ ^"by" ~ ^"creatures" ~ ^"with" ~ keyword ~ ^"and" ~ ^"creatures"
  ~ ^"in" ~ article ~ ^"pile" ~ ^"with" ~ ^"the" ~ ^"chosen"
  ~ ^"label" ~ "."
}

enchanted_object = _{ permanent_type | creature_type }

// Activated abilities have a printed cost before the colon and one or
// more effects after it. The cost pieces are kept explicit because tap
// symbols are costs but not mana symbols.
activated_ability_with_activation_permission = {
    activated_ability ~ activation_permission
}
activation_permission = _{
    only_sources_owner_may_activate_this_ability
  | activate_only_during_your_upkeep
}
activated_ability = { activated_cost ~ ":" ~ activated_effect }
// Multiple non-mana activated costs are printed comma-separated.
activated_cost = { activated_cost_component ~ ("," ~ activated_cost_component)* }
activated_cost_component = _{
    remove_named_counter_from_source
  | sacrifice_source
  | variable_mana_symbol
  | mana_cost
  | tap_symbol
}
activated_effect = _{
    add_mana_of_any_one_color
  | add_one_mana_of_any_color
  | add_mana
  | tap_target_permanent_choice
  | target_permanent_becomes_basic_land_type_until_source_leaves
  | destroy
  | regenerate_source
  | colored_target_effect
  | counter_target_colored_spell
  | untap_target_permanent
  | untap_source
  | untap_enchanted_object
  | take_extra_turn_after_this_one
  | next_card_draw_replacement
  | imperative_action_sequence
  | activated_draw_cards
  | flip_coin
  | create_token
  | look_at_target_players_hand
  | target_player_discards_cards
  | gain_control_of_target_permanent_for_as_long_as_you_control_source
  | target_creature_with_power_or_less_cant_be_blocked
  | target_permanent_gains_keyword_until_eot
  | activated_source_becomes_pt_creature_until_end_of_combat
  | activated_source_gains_keyword_until_eot
  | activated_source_gets_until_eot
  | activated_enchanted_gets_until_eot
  | activated_damage_effect
  | put_pt_counters_on_source
  | put_named_counter_on_target_non_basic_land
  | choose_creature_card_in_hand_payable_by_mana_spent_on_variable
  | choose_target_non_creature_type_creature_active_player_controlled_continuously
  | physical_action
}
add_mana_of_any_one_color = {
    ^"add" ~ number_word ~ ^"mana" ~ ^"of" ~ ^"any" ~ ^"one" ~ ^"color" ~ "."
}
add_one_mana_of_any_color = { ^"add" ~ ^"one" ~ ^"mana" ~ ^"of" ~ ^"any" ~ ^"color" ~ "." }
add_mana = { ^"add" ~ add_mana_amount ~ "." }
add_mana_amount = _{ mana_cost | amount_of_mana_equal_to_sacrificed_permanent_mana_value }
amount_of_mana_equal_to_sacrificed_permanent_mana_value = {
    article ~ ^"amount" ~ ^"of" ~ mana_symbol ~ ^"equal" ~ ^"to"
  ~ ^"the" ~ ^"sacrificed" ~ permanent_type ~ "'s" ~ ^"mana" ~ ^"value"
}
tap_target_permanent_choice = {
    (^"you" ~ ^"may")? ~ ^"tap" ~ (^"or" ~ ^"untap")? ~ tap_untap_target_choice ~ "."
}
tap_untap_target_choice = { target_permanent_choice | target_creature_type }
target_permanent_choice = { ^"target" ~ (^"permanent" | permanent_type_choice) }
target_colored_permanent = { ^"target" ~ color_word ~ ^"permanent" }
target_status_creature = { ^"target" ~ creature_status ~ ^"creature" }
target_qualified_creature = {
    ^"target" ~ creature_quality ~ ("," ~ creature_quality)* ~ ^"creature"
}
creature_quality = _{ non_permanent_type | non_color_word }
non_permanent_type = { ^"non" ~ permanent_type }
non_color_word = { ^"non" ~ color_word }
target_creature_type = { ^"target" ~ creature_type }
permanent_type_choice = { permanent_type ~ ((("," ~ permanent_type)* ~ ","? ~ ^"or") ~ permanent_type)? }
activated_draw_cards = {
    ^"draw" ~ draw_card_object ~ "."
}
flip_coin = { ^"flip" ~ article ~ ^"coin" ~ "." }
draw_card_object = _{ activated_draw_one_card | activated_draw_counted_cards }
activated_draw_one_card = { article ~ ^"card" }
activated_draw_counted_cards = { draw_count ~ ^"cards" }
next_card_draw_replacement = {
    ^"the" ~ ^"next" ~ ^"time" ~ ^"you" ~ ^"would" ~ ^"draw"
  ~ article ~ ^"card" ~ ^"this" ~ ^"turn" ~ "," ~ ^"instead"
  ~ filter_top_library_cards
}
filter_top_library_cards = {
    ^"look" ~ ^"at" ~ ^"the" ~ ^"top" ~ draw_count ~ ^"cards"
  ~ ^"of" ~ ^"your" ~ ^"library" ~ "," ~ ^"put" ~ ^"all" ~ ^"but"
  ~ ^"one" ~ ^"of" ~ ^"them" ~ ^"on" ~ ^"the" ~ ^"bottom" ~ ^"of"
  ~ ^"your" ~ ^"library" ~ ^"in" ~ article ~ ^"random" ~ ^"order"
  ~ "," ~ ^"then" ~ ^"draw" ~ article ~ ^"card" ~ "."
}
create_token = {
    ^"create" ~ article ~ unsigned_number ~ "/" ~ unsigned_number
  ~ token_color? ~ creature_type? ~ permanent_type+ ~ ^"token"
  ~ token_keyword_clause? ~ token_name_clause? ~ "."
}
token_color = { color_word | colorless_word }
colorless_word = @{ ^"colorless" }
token_keyword_clause = { ^"with" ~ keyword }
token_name_clause = { ^"named" ~ proper_name }
target_permanent_becomes_basic_land_type_until_source_leaves = {
    ^"target" ~ permanent_type ~ ^"becomes" ~ article ~ basic_land_type
  ~ ^"until" ~ source_object ~ ^"leaves" ~ ^"the" ~ ^"battlefield" ~ "."
}
regenerate_source = { ^"regenerate" ~ (source_object | (^"enchanted" ~ enchanted_object)) ~ "."? }
untap_target_permanent = { ^"untap" ~ ^"target" ~ permanent_type ~ "." }
untap_source = { ^"untap" ~ source_object ~ "." }
untap_enchanted_object = { ^"untap" ~ ^"enchanted" ~ enchanted_object ~ "." }
untap_referenced_permanent = { ^"untap" ~ ^"the" ~ permanent_type ~ "." }
take_extra_turn_after_this_one = {
    ^"take" ~ article ~ ^"extra" ~ ^"turn" ~ ^"after" ~ ^"this" ~ ^"one" ~ "."
}
look_at_target_players_hand = { look_at_target_hand_action ~ "." }
target_player_discards_cards = {
  target_player_discard_prefix ~ discard_amount ~ "."
}
discard_one_card = { article ~ ^"card" }
discard_counted_cards = { draw_count ~ ^"cards" }
gain_control_of_target_permanent_for_as_long_as_you_control_source = {
    ^"gain" ~ ^"control" ~ ^"of" ~ ^"target" ~ permanent_type
  ~ ^"for" ~ ^"as" ~ ^"long" ~ ^"as" ~ ^"you" ~ ^"control"
  ~ source_object ~ "."
}
choose_target_non_creature_type_creature_active_player_controlled_continuously = {
    ^"choose" ~ ^"target" ~ ^"non-" ~ creature_type ~ ^"creature"
  ~ ^"the" ~ ^"active" ~ ^"player" ~ ^"has" ~ ^"controlled"
  ~ ^"continuously" ~ ^"since" ~ ^"the" ~ ^"beginning" ~ ^"of"
  ~ ^"the" ~ ^"turn" ~ "."
}
target_creature_with_power_or_less_cant_be_blocked = {
    ^"target" ~ ^"creature" ~ ^"with" ~ ^"power" ~ unsigned_number
  ~ ^"or" ~ ^"less" ~ ^"can't" ~ ^"be" ~ ^"blocked"
  ~ ^"this" ~ ^"turn" ~ "."
}
target_permanent_gains_keyword_until_eot = {
    ^"target" ~ target_permanent_selector ~ target_permanent_gains_keyword_eot_effect ~ "."
}
activated_source_gets_until_eot = {
    source_object ~ ^"gets" ~ pt_modifier ~ ^"until" ~ ^"end" ~ ^"of" ~ ^"turn" ~ "."
}
activated_source_gains_keyword_until_eot = {
    source_object ~ ^"gains" ~ keyword ~ ^"until" ~ ^"end" ~ ^"of" ~ ^"turn" ~ "."
}
activated_source_becomes_pt_creature_until_end_of_combat = {
    source_object ~ ^"becomes" ~ article ~ unsigned_number ~ "/" ~ unsigned_number
  ~ creature_type ~ permanent_type+ ~ ^"until" ~ ^"end" ~ ^"of" ~ ^"combat" ~ "."
}
activated_enchanted_gets_until_eot = {
    ^"enchanted" ~ permanent_type ~ ^"gets" ~ pt_modifier
  ~ ^"until" ~ ^"end" ~ ^"of" ~ ^"turn" ~ "."
}
activated_damage_effect = _{
    activated_direct_damage_effect
  | next_damage_event_effect
  | next_damage_redirection_effect
  | activated_damage_prevention_effect
}
activated_direct_damage_effect = {
    source_object ~ ^"deals" ~ damage_assignment
  ~ (^"and" ~ damage_assignment)* ~ "."
}
damage_assignment = {
    damage_event_amount ~ ^"damage" ~ ^"to" ~ activated_damage_recipient_list
}
activated_damage_recipient_list = {
    activated_direct_damage_recipient
  ~ (^"and" ~ !damage_assignment ~ activated_direct_damage_recipient)*
}
activated_direct_damage_recipient = _{
    any_target_of_opponents_choice_damage_recipient
  | you_damage_recipient
  | any_target_prevention_recipient
  | target_permanent_damage_recipient
  | each_creature_damage_recipient
  | each_player_damage_recipient
}
any_target_of_opponents_choice_damage_recipient = {
    ^"any" ~ ^"target" ~ ^"of" ~ article ~ ^"opponent's" ~ ^"choice"
}
next_damage_event_effect = {
    ^"the" ~ ^"next" ~ ^"time" ~ activated_damage_source
  ~ ^"of" ~ ^"your" ~ ^"choice" ~ ^"would" ~ ^"deal"
  ~ damage_kind? ~ ^"damage" ~ ^"to" ~ activated_damage_recipient
  ~ ^"this" ~ ^"turn" ~ "," ~ activated_damage_event_result ~ "."
}
activated_damage_source = _{
    colored_damage_source
  | unblocked_creature_damage_source
  | chosen_damage_source
}
colored_damage_source = { article ~ color_word ~ ^"source" }
unblocked_creature_damage_source = { article ~ ^"unblocked" ~ ^"creature" }
chosen_damage_source = { article ~ ^"source" }
damage_kind = { ^"combat" }
activated_damage_recipient = _{ you_damage_recipient | target_permanent_damage_recipient }
activated_damage_redirection_recipient = _{
    activated_damage_recipient
  | source_object_damage_recipient
}
activated_damage_prevention_recipient = _{
    you_damage_recipient
  | any_target_prevention_recipient
  | source_object_damage_recipient
}
activated_damage_prevention_recipient_clause = { ^"to" ~ activated_damage_prevention_recipient }
target_permanent_damage_recipient = { ^"target" ~ permanent_type }
source_object_damage_recipient = { source_object }
activated_damage_event_result = _{
    prevent_that_damage
  | prevent_all_but_that_damage
  | redirect_that_damage_to_you
}
prevent_that_damage = { ^"prevent" ~ ^"that" ~ ^"damage" }
prevent_all_but_that_damage = {
    ^"prevent" ~ ^"all" ~ ^"but" ~ unsigned_number ~ ^"of" ~ ^"that" ~ ^"damage"
}
redirect_that_damage_to_you = {
    ^"that" ~ ^"source" ~ ^"deals" ~ ^"that" ~ ^"damage" ~ ^"to" ~ ^"you" ~ ^"instead"
}
next_damage_redirection_effect = {
    ^"the" ~ ^"next" ~ damage_prevention_amount ~ damage_kind? ~ ^"damage"
  ~ ^"that" ~ ^"would" ~ ^"be" ~ ^"dealt" ~ ^"to"
  ~ activated_damage_redirection_recipient ~ ^"this" ~ ^"turn" ~ ^"is"
  ~ ^"dealt" ~ ^"to" ~ damage_redirection_destination ~ ^"instead" ~ "."
}
damage_redirection_destination = _{ its_owner_damage_destination }
its_owner_damage_destination = { ^"its" ~ ^"owner" }
activated_damage_prevention_effect = {
    damage_prevention_replacement_event ~ activated_damage_prevention_recipient_clause
  ~ damage_prevention_duration
}
put_pt_counters_on_source = {
    ^"put" ~ pt_counter_put_amount ~ (pt_counters | pt_counter)
  ~ ^"on" ~ source_object ~ "."
}
pt_counter_put_amount = {
    put_up_to_counter_amount
  | put_exact_counter_amount
  | put_single_counter_amount
}
put_up_to_counter_amount = { ^"up" ~ ^"to" ~ counter_amount }
put_exact_counter_amount = { counter_amount }
put_single_counter_amount = { article }
put_named_counter_on_target_non_basic_land = {
    ^"put" ~ article ~ named_counter ~ ^"on" ~ ^"target" ~ non_basic_land_type ~ permanent_type ~ "."
}
choose_creature_card_in_hand_payable_by_mana_spent_on_variable = {
    ^"you" ~ ^"may" ~ ^"choose" ~ article ~ ^"creature" ~ ^"card"
  ~ ^"in" ~ ^"your" ~ ^"hand" ~ ^"whose" ~ ^"mana" ~ ^"cost"
  ~ ^"could" ~ ^"be" ~ ^"paid" ~ ^"by" ~ ^"some" ~ ^"amount"
  ~ ^"of" ~ "," ~ ^"or" ~ ^"all" ~ ^"of" ~ "," ~ ^"the"
  ~ ^"mana" ~ ^"you" ~ ^"spent" ~ ^"on" ~ variable_mana_symbol ~ "."
}
variable_mana_symbol = ${ "{" ~ variable_name ~ "}" }
sacrifice_source = { ^"sacrifice" ~ source_object }
remove_named_counter_from_source = {
    ^"remove" ~ article ~ named_counter ~ ^"from" ~ source_object
}

physical_action = _{
    if_source_on_battlefield_flip_onto_battlefield_from_height
  | if_source_turns_over_destroy_touched_nontoken_permanents
  | then_destroy_source
}

if_source_on_battlefield_flip_onto_battlefield_from_height = {
    ^"if" ~ source_object ~ ^"is" ~ ^"on" ~ ^"the" ~ ^"battlefield"
  ~ "," ~ ^"flip" ~ ^"it" ~ ^"onto" ~ ^"the" ~ ^"battlefield"
  ~ ^"from" ~ article ~ ^"height" ~ ^"of" ~ ^"at" ~ ^"least"
  ~ number_word ~ physical_height_unit ~ "."
}

if_source_turns_over_destroy_touched_nontoken_permanents = {
    ^"if" ~ source_object ~ ^"turns" ~ ^"over" ~ ^"completely"
  ~ ^"at" ~ ^"least" ~ ^"once" ~ ^"during" ~ ^"the" ~ ^"flip"
  ~ "," ~ ^"destroy" ~ ^"all" ~ ^"nontoken" ~ ^"permanents"
  ~ ^"it" ~ ^"touches" ~ "."
}

then_destroy_source = {
    ^"then" ~ ^"destroy" ~ source_object ~ "."
}

physical_height_unit = @{ ^"feet" | ^"foot" }

condition      = _{ you_control_basic_land | source_is_object_status | source_isnt_attacking | source_is_attacking | enchanted_isnt }
you_control_basic_land = { ^"you" ~ ^"control" ~ article ~ basic_land_type }
enchanted_isnt = {
    ^"enchanted" ~ permanent_type ~ ^"isn't" ~ article ~ permanent_type
}
source_is_object_status = { source_object ~ ^"is" ~ object_status }
source_isnt_attacking = { proper_name ~ ^"isn't" ~ ^"attacking" }
source_is_attacking   = { proper_name ~ ^"is" ~ ^"attacking" }

continuous_effect       = _{ source_gets | static_damage_prevention_effect | damage_that_would_be_dealt_to_you_by_source_is_dealt_to_source_instead | source_pt_equal_to_basic_lands_controlled | becomes_pt_from_mv | static_untap_restriction_during_untap_steps }
source_gets = {
    source_object ~ ^"gets" ~ pt_modifier
}
static_damage_prevention_effect = {
    ^"prevent" ~ damage_prevention_amount_axis ~ damage_kind? ~ ^"damage"
  ~ static_damage_prevention_source ~ ^"would" ~ ^"deal" ~ ^"to"
  ~ static_damage_prevention_recipient ~ (^"and" ~ ^"to" ~ static_damage_prevention_recipient)*
}
static_damage_prevention_source = _{ land_subtype_plural }
land_subtype_plural = @{ ^"deserts" }
static_damage_prevention_recipient = _{
    source_object_damage_recipient
  | banded_creatures_prevention_recipient
}
banded_creatures_prevention_recipient = {
    ^"creatures" ~ ^"banded" ~ ^"with" ~ source_object
}
damage_that_would_be_dealt_to_you_by_source_is_dealt_to_source_instead = {
    ^"all" ~ ^"damage" ~ ^"that" ~ ^"would" ~ ^"be" ~ ^"dealt"
  ~ ^"to" ~ ^"you" ~ ^"by" ~ static_damage_source
  ~ ^"is" ~ ^"dealt" ~ ^"to" ~ (source_object | ^"that" ~ ^"source") ~ ^"instead"
}
static_damage_source = _{ article ~ ^"source" | unblocked_creatures_damage_source }
unblocked_creatures_damage_source = { ^"unblocked" ~ ^"creatures" }
becomes_pt_from_mv = {
    ^"it's" ~ article ~ permanent_type+
  ~ ^"with" ~ ^"power" ~ ^"and" ~ ^"toughness"
  ~ ^"each" ~ ^"equal" ~ ^"to" ~ ^"its" ~ ^"mana" ~ ^"value"
}
source_pt_equal_to_basic_lands_controlled = {
    ^"its" ~ ^"power" ~ ^"and" ~ ^"toughness" ~ ^"are" ~ ^"each"
  ~ ^"equal" ~ ^"to" ~ ^"the" ~ ^"number" ~ ^"of"
  ~ basic_land_type_plural ~ land_count_controller
}
land_count_controller = { ^"you" ~ ^"control" | ^"defending" ~ ^"player" ~ ^"controls" }

// "+1/+1", "-1/-0", "+0/-2" — sign is always explicit on both sides.
pt_modifier   = ${ signed_number ~ "/" ~ signed_number }
signed_number = @{ ("+" | "-") ~ ASCII_DIGIT+ }
pt_counter    = { pt_modifier ~ ^"counter" }
pt_counters   = { pt_modifier ~ ^"counters" }

// "+X/+Y, where X is ..." — sign is explicit on both variables, and
// the variable definitions carry the arithmetic printed after "where".
variable_pt_modifier = { signed_variable ~ "/" ~ signed_variable }
signed_variable      = @{ ("+" | "-") ~ variable_name }
variable_name        = @{ "X" | "Y" }

mixed_pt_modifier = { signed_pt_component ~ "/" ~ signed_pt_component }
signed_pt_component = _{ signed_variable | signed_number }

where_clause         = { ^"where" ~ variable_definition ~ ("," ~ ^"and" ~ variable_definition)? }
variable_definition  = { variable_name ~ ^"is" ~ value_expression }
value_expression     = _{
    unsigned_number
  | half_number_of_basic_lands_you_control
  | number_of_permanents_you_control
  | number_of_status_permanents_they_controlled_at_beginning_of_this_turn
  | number_of_cards_in_their_hand_minus
  | amount_of_mana_that_player_paid_this_way
  | its_power
}
number_of_permanents_you_control = {
    ^"the" ~ ^"number" ~ ^"of" ~ permanent_type_plural ~ ^"you" ~ ^"control"
}
half_number_of_basic_lands_you_control = {
    ^"half" ~ ^"the" ~ ^"number" ~ ^"of" ~ basic_land_type_plural
  ~ ^"you" ~ ^"control" ~ "," ~ rounding
}
number_of_cards_in_their_hand_minus = {
    ^"the" ~ ^"number" ~ ^"of" ~ ^"cards" ~ ^"in" ~ ^"their"
  ~ ^"hand" ~ ^"minus" ~ unsigned_number
}
number_of_status_permanents_they_controlled_at_beginning_of_this_turn = {
    ^"the" ~ ^"number" ~ ^"of" ~ object_status ~ permanent_type_plural
  ~ ^"they" ~ ^"controlled" ~ ^"at" ~ ^"the" ~ ^"beginning" ~ ^"of"
  ~ ^"this" ~ ^"turn"
}
amount_of_mana_that_player_paid_this_way = {
    ^"the" ~ ^"amount" ~ ^"of" ~ ^"mana" ~ ^"that" ~ ^"player"
  ~ ^"paid" ~ ^"this" ~ ^"way"
}
its_power = { ^"its" ~ ^"power" }
unsigned_number = @{ ASCII_DIGIT+ }
rounding = { ^"rounded" ~ rounding_direction }
rounding_direction = @{ ^"down" | ^"up" }
basic_land_type_plural = @{
    ^"plains"
  | ^"islands"
  | ^"swamps"
  | ^"mountains"
  | ^"forests"
}
basic_land_type = @{
    ^"plains"
  | ^"island"
  | ^"swamp"
  | ^"mountain"
  | ^"forest"
}
non_basic_land_type = { ^"non-" ~ basic_land_type }
named_counter = { counter_name ~ ^"counter" }
named_counters = { counter_name ~ ^"counters" }
counter_name = @{ ASCII_ALPHA+ }

// "When <event>, [if <cond>,] <effect>+"
// The trigger condition owns the event, the comma after it, and the
// optional intervening-if clause. The effect sequence stays separate so
// the printed order is event/condition first, then effects.
// Each trigger_effect rule below carries its own terminator (a closing
// "." or a closing quote that absorbs a period). Effects are then just
// space-separated within the trigger; no ". " separator is needed at
// this layer.
triggered_ability = {
    trigger_word ~ trigger_condition ~ trigger_effect_sequence
}

triggered_ability_fragment = {
    trigger_word ~ trigger_condition ~ trigger_effect_fragment_sequence ~ !"."
}

trigger_condition = { trigger_event_clause ~ "," ~ trigger_intervening_if_clause? }
trigger_event_clause = { trigger_event }
trigger_intervening_if_clause = { ^"if" ~ intervening_if ~ "," }
trigger_effect_sequence = { trigger_effect ~ (^"and"? ~ trigger_effect)* }
trigger_effect_fragment_sequence = {
    you_may_pay_mana ~ if_you_do_gain_life_fragment
  | you_may_have_source_become_copy_of_target_fragment
}

// "Whenever" is listed first because "When" is its prefix.
trigger_word = _{ ^"whenever" | ^"when" | ^"at" }

trigger_event = _{
    you_are_dealt_damage
  | permanent_put_into_graveyard_from_battlefield
  | permanent_dealt_damage_by_source_this_turn_dies
  | source_put_into_graveyard_from_battlefield
  | source_dies
  | source_deals_damage_to_an_opponent
  | source_is_dealt_damage
  | aura_leaves_battlefield
  | aura_enters
  | enchanted_permanent_dies
  | source_blocks_or_becomes_blocked_by_non_creature_type_creature
  | enchanted_object_becomes_status
  | you_control_no_basic_lands
  | end_of_combat
  | beginning_of_each_players_draw_step
  | beginning_of_your_draw_step
  | beginning_of_each_players_upkeep
  | beginning_of_your_upkeep
  | beginning_of_upkeep_of_enchanted_permanent_controller
  | beginning_of_chosen_players_upkeep
  | beginning_of_each_end_step
  | beginning_of_the_end_step
  | beginning_of_the_next_end_step
  | you_play_permanent
  | player_taps_permanent_for_mana
  | player_casts_colored_spell
  | basic_land_type_is_tapped_for_mana
  | basic_land_type_controller_becomes_status
  | article ~ color_word ~ ^"creature" ~ ^"attacks"
  | one_or_more_creatures_you_control_attack
  | one_or_more_permanents_with_original_printing_on_battlefield
  | permanent_enters
}
aura_enters             = { ^"this" ~ ^"aura" ~ ^"enters" }
aura_leaves_battlefield = { ^"this" ~ ^"aura" ~ ^"leaves" ~ ^"the" ~ ^"battlefield" }
source_put_into_graveyard_from_battlefield = {
    source_object ~ ^"is" ~ ^"put" ~ ^"into" ~ article ~ zone
  ~ ^"from" ~ ^"the" ~ ^"battlefield"
}
source_is_dealt_damage = { source_object ~ ^"is" ~ ^"dealt" ~ ^"damage" }
you_are_dealt_damage = { ^"you're" ~ ^"dealt" ~ ^"damage" }
source_deals_damage_to_an_opponent = {
    source_object ~ ^"deals" ~ ^"damage" ~ ^"to" ~ article ~ ^"opponent"
}
permanent_put_into_graveyard_from_battlefield = {
    article ~ permanent_type
  ~ (
        ^"is" ~ ^"put" ~ ^"into" ~ article ~ zone ~ ^"from" ~ ^"the" ~ ^"battlefield"
      | ^"dies"
    )
}
permanent_dealt_damage_by_source_this_turn_dies = {
    article ~ permanent_type ~ ^"dealt" ~ ^"damage" ~ ^"by" ~ source_object
  ~ ^"this" ~ ^"turn" ~ ^"dies"
}
enchanted_permanent_dies = { ^"enchanted" ~ permanent_type ~ ^"dies" }
source_dies = { source_object ~ ^"dies" }
enchanted_object_becomes_status = {
    (^"enchanted" ~ enchanted_object | source_object) ~ ^"becomes" ~ object_status
}
you_control_no_basic_lands = { ^"you" ~ ^"control" ~ ^"no" ~ basic_land_type_plural }
permanent_enters        = { (article ~ permanent_type | source_object) ~ ^"enters" }
basic_land_type_is_tapped_for_mana = {
    (article ~ basic_land_type | ^"enchanted" ~ enchanted_object)
  ~ ^"is" ~ ^"tapped" ~ ^"for" ~ ^"mana"
}
basic_land_type_controller_becomes_status = {
    article ~ basic_land_type ~ permanent_controller ~ ^"becomes" ~ object_status
}
permanent_controller = { ^"you" ~ ^"control" | article ~ ^"opponent" ~ ^"controls" }
player_taps_permanent_for_mana = {
    article ~ ^"player" ~ ^"taps" ~ article ~ permanent_type ~ ^"for" ~ ^"mana"
}
player_casts_colored_spell = {
    (you_cast_spell_actor ~ ^"cast" | player_cast_spell_actor ~ ^"casts")
  ~ article ~ cast_spell_descriptor ~ ^"spell"
}
you_cast_spell_actor = { ^"you" }
player_cast_spell_actor = { article ~ ^"player" }
cast_spell_descriptor = _{ color_word | permanent_type }
you_play_permanent = { ^"you" ~ ^"play" ~ article ~ permanent_type }
one_or_more_creatures_you_control_attack = {
    ^"one" ~ ^"or" ~ ^"more" ~ ^"creatures" ~ ^"you" ~ ^"control" ~ ^"attack"
}
one_or_more_permanents_with_original_printing_on_battlefield = {
    ^"one" ~ ^"or" ~ ^"more" ~ ^"other"? ~ ^"nontoken"?
  ~ ^"permanents" ~ original_printing_expansion_clause
  ~ ^"are" ~ ^"on" ~ ^"the" ~ ^"battlefield"
}
source_blocks_or_becomes_blocked_by_non_creature_type_creature = {
    source_object ~ ^"blocks" ~ ^"or" ~ ^"becomes" ~ ^"blocked"
  ~ ^"by" ~ article ~ ^"non-" ~ creature_type ~ ^"creature"
}
original_printing_expansion_clause = {
    ^"with" ~ article ~ ^"name" ~ ^"originally" ~ ^"printed" ~ ^"in"
  ~ ^"the" ~ proper_name ~ ^"expansion"
}
end_of_combat           = { ^"end" ~ ^"of" ~ ^"combat" }
beginning_of_the_next_end_step = {
    ^"the" ~ ^"beginning" ~ ^"of" ~ ^"the" ~ ^"next" ~ ^"end" ~ ^"step"
}
beginning_of_the_end_step = {
    ^"the" ~ ^"beginning" ~ ^"of" ~ ^"the" ~ ^"end" ~ ^"step"
}
beginning_of_each_end_step = {
    ^"the" ~ ^"beginning" ~ ^"of" ~ ^"each" ~ ^"end" ~ ^"step"
}
beginning_of_chosen_players_upkeep = {
    ^"the" ~ ^"beginning" ~ ^"of" ~ ^"the" ~ ^"chosen" ~ ^"player's" ~ ^"upkeep"
}
beginning_of_each_players_upkeep = {
    ^"the" ~ ^"beginning" ~ ^"of" ~ ^"each" ~ ^"player's" ~ ^"upkeep"
}
beginning_of_each_players_draw_step = {
    ^"the" ~ ^"beginning" ~ ^"of" ~ ^"each" ~ ^"player's" ~ ^"draw" ~ ^"step"
}
beginning_of_your_draw_step = {
    ^"the" ~ ^"beginning" ~ ^"of" ~ ^"your" ~ ^"draw" ~ ^"step"
}
beginning_of_your_upkeep = {
    ^"the" ~ ^"beginning" ~ ^"of" ~ ^"your" ~ ^"upkeep"
}
beginning_of_upkeep_of_enchanted_permanent_controller = {
    ^"the" ~ ^"beginning" ~ ^"of" ~ ^"the" ~ ^"upkeep" ~ ^"of"
  ~ ^"enchanted" ~ permanent_type ~ "'s" ~ ^"controller"
}

intervening_if         = _{ this_card_in_your_graveyard_with_cards_above_it | its_on_the_battlefield | no_permanents_are_on_the_battlefield | enchanted_has_keyword | it_wasnt_first_permanent_you_played_this_turn | source_attacked_or_blocked_this_combat | source_object_is_status }
its_on_the_battlefield = { ^"it's" ~ ^"on" ~ ^"the" ~ ^"battlefield" }
no_permanents_are_on_the_battlefield = {
    ^"no" ~ permanent_type_plural ~ ^"are" ~ ^"on" ~ ^"the" ~ ^"battlefield"
}
this_card_in_your_graveyard_with_cards_above_it = {
    ^"this" ~ ^"card" ~ ^"is" ~ ^"in" ~ ^"your" ~ zone
  ~ ^"with" ~ number_word ~ ^"or" ~ ^"more" ~ permanent_type ~ ^"cards"
  ~ ^"above" ~ ^"it"
}
enchanted_has_keyword = { ^"enchanted" ~ enchanted_object ~ ^"has" ~ keyword }
it_wasnt_first_permanent_you_played_this_turn = {
    ^"it" ~ ^"wasn't" ~ ^"the" ~ ^"first" ~ permanent_type
  ~ ^"you" ~ ^"played" ~ ^"this" ~ ^"turn"
}
source_attacked_or_blocked_this_combat = {
    source_object ~ ^"attacked" ~ ^"or" ~ ^"blocked" ~ ^"this" ~ ^"combat"
}
source_object_is_status = { source_object ~ ^"is" ~ object_status }
object_status = { creature_status }

trigger_effect = _{
    destroy_all_non_creature_type_creatures_that_player_controls_that_didnt_attack_this_turn
  | destroy_all_creatures_blocking_or_blocked_by_it
  | destroy_that_creature_if_it_attacked_this_turn
  | destroy_it
  | destroy_that_creature_at_end_of_combat
  | sacrifice_permanent_other_than_source
  | delayed_remove_all_named_counters_from_linked_land
  | put_named_counters_on_source
  | you_may_remove_named_counter_from_source
  | put_pt_counter_on_it
  | remove_pt_counter_from_it
  | loses_and_gains_keyword
  | return_enchanted_card_and_attach
  | unless_you_pay_mana_do_actions
  | you_may_put_this_card_onto_the_battlefield
  | player_may_pay_mana
  | you_may_have_source_become_copy_of_target
  | you_may_draw_cards
  | activated_draw_cards
  | damage_prevention_effect_sentence
  | tap_enchanted_object
  | if_you_do_gain_life
  | sacrifice_source_effect
  | sacrifice_source_unless_you_pay
  | source_deals_damage
  | that_player_adds_mana_of_any_type_that_permanent_produced
  | that_player_discards_card_at_random
  | that_player_draws_an_additional_card
  | its_controller_adds_an_additional_mana
  | defending_player_divides_creatures_without_keyword_into_labeled_piles
  | source_gains_static_ability
  | that_creatures_controller_sacrifices_it
  | their_controllers_sacrifice_them
  | sacrifice_that_many_nontoken_permanents
  | player_loses_life
  | you_lose_the_game
  | you_gain_life
}

destroy_all_non_creature_type_creatures_that_player_controls_that_didnt_attack_this_turn = {
    ^"destroy" ~ ^"all" ~ ^"non-" ~ creature_type ~ ^"creatures"
  ~ ^"that" ~ ^"player" ~ ^"controls" ~ ^"that" ~ ^"didn't"
  ~ ^"attack" ~ ^"this" ~ ^"turn" ~ "."
}

destroy_all_creatures_blocking_or_blocked_by_it = {
    ^"destroy" ~ all_creatures_blocking_or_blocked_by_it ~ "."
}

defending_player_divides_creatures_without_keyword_into_labeled_piles = {
    ^"each" ~ ^"defending" ~ ^"player" ~ ^"divides" ~ ^"all"
  ~ ^"creatures" ~ ^"without" ~ keyword ~ ^"they" ~ ^"control"
  ~ ^"into" ~ article ~ quoted_label_pile ~ ^"and" ~ article
  ~ quoted_label_pile ~ "."
}
quoted_label_pile = { quoted_label ~ ^"pile" }

target_spell_or_permanent_becomes_color = {
    ^"target" ~ ^"spell" ~ ^"or" ~ ^"permanent" ~ ^"becomes" ~ color_word ~ "."
}

change_text_of_target_spell_or_permanent_replacing_basic_land_type = {
    ^"change" ~ ^"the" ~ ^"text" ~ ^"of" ~ ^"target" ~ ^"spell" ~ ^"or" ~ ^"permanent"
  ~ ^"by" ~ ^"replacing" ~ ^"all" ~ ^"instances" ~ ^"of" ~ ^"one"
  ~ text_change_replacement_term ~ ^"with" ~ ^"another" ~ "."
}
text_change_replacement_term = {
    ^"basic" ~ ^"land" ~ ^"type"
  | ^"color" ~ ^"word"
}

target_permanent_until_eot = {
    ^"target" ~ target_permanent_selector ~ target_permanent_eot_effect ~ "."
}
target_permanent_selector = {
    controlled_creature_with_toughness_less_than_source_power
  | combat_role ~ ^"creature"
  | permanent_type
}
controlled_creature_with_toughness_less_than_source_power = {
    ^"creature" ~ ^"you" ~ ^"control" ~ ^"with" ~ ^"toughness"
  ~ ^"less" ~ ^"than" ~ source_object ~ "'s" ~ ^"power"
}
combat_role = @{ ^"attacking" | ^"blocking" }
target_permanent_eot_effect = _{
    target_permanent_gains_keyword_and_gets_eot_effect
  | target_permanent_gets_eot_effect
  | target_permanent_gains_keyword_eot_effect
}
target_permanent_gains_keyword_eot_effect = {
    ^"gains" ~ keyword ~ ^"until" ~ ^"end" ~ ^"of" ~ ^"turn"
}
target_permanent_gets_eot_effect = {
    // Variable pump spells can print mixed modifiers such as "+X/+0".
    ^"gets" ~ mixed_pt_modifier ~ ^"until" ~ ^"end" ~ ^"of" ~ ^"turn"
}
target_permanent_gains_keyword_and_gets_eot_effect = {
    ^"gains" ~ keyword ~ ^"and" ~ ^"gets" ~ mixed_pt_modifier
  ~ ^"until" ~ ^"end" ~ ^"of" ~ ^"turn" ~ "," ~ where_clause
}

source_enters_with_pt_counters = {
    source_object ~ ^"enters" ~ ^"with" ~ counter_amount ~ pt_counters
  ~ ^"on" ~ ^"it" ~ "."
}
counter_amount = _{ variable_name | number_word }

for_each_damage_prevented_by_removing_pt_counter = {
    ^"for" ~ ^"each" ~ damage_amount_expression ~ ^"damage" ~ ^"that"
  ~ ^"would" ~ ^"be" ~ ^"dealt" ~ ^"to" ~ source_object ~ ","
  ~ ^"if" ~ ^"it" ~ ^"has" ~ article ~ pt_counter ~ ^"on" ~ ^"it"
  ~ "," ~ ^"remove" ~ article ~ pt_counter ~ ^"from" ~ ^"it"
  ~ ^"and" ~ ^"prevent" ~ ^"that" ~ damage_amount_expression
  ~ ^"damage" ~ "."
}

this_ability_cant_cause_total_pt_counters_greater_than = {
    ^"this" ~ ^"ability" ~ ^"can't" ~ ^"cause" ~ ^"the" ~ ^"total"
  ~ ^"number" ~ ^"of" ~ pt_counters ~ ^"on" ~ source_object
  ~ ^"to" ~ ^"be" ~ ^"greater" ~ ^"than" ~ number_word ~ "."
}

if_this_ability_activated_at_least_times_this_turn_sacrifice_source_at_next_end_step = {
    ^"if" ~ ^"this" ~ ^"ability" ~ ^"has" ~ ^"been" ~ ^"activated"
  ~ number_word ~ ^"or" ~ ^"more" ~ ^"times" ~ ^"this" ~ ^"turn"
  ~ "," ~ ^"sacrifice" ~ source_object ~ ^"at" ~ beginning_of_the_next_end_step ~ "."
}

if_you_do_cast_that_card_face_down_without_paying_mana_cost = {
    ^"if" ~ ^"you" ~ ^"do" ~ "," ~ ^"you" ~ ^"may" ~ ^"cast"
  ~ ^"that" ~ ^"card" ~ ^"face" ~ ^"down" ~ ^"as" ~ article
  ~ unsigned_number ~ "/" ~ unsigned_number ~ ^"creature" ~ ^"spell"
  ~ ^"without" ~ ^"paying" ~ ^"its" ~ ^"mana" ~ ^"cost" ~ "."
}

if_face_down_spell_creature_would_assign_or_deal_damage_or_tap_turn_face_up_instead = {
