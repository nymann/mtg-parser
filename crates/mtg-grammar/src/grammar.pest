  | copy_exception_doesnt_copy_color_and_has_this_ability
}
copy_exception_permanent_type_in_addition = {
    "," ~ ^"except" ~ ^"it's" ~ article ~ permanent_type
  ~ ^"in" ~ ^"addition" ~ ^"to" ~ ^"its" ~ ^"other" ~ ^"types"
}
copy_exception_doesnt_copy_color_and_has_this_ability = {
    "," ~ ^"except" ~ ^"it" ~ ^"doesn't" ~ ^"copy" ~ ^"that"
  ~ permanent_type ~ "'s" ~ ^"color" ~ ^"and" ~ ^"it" ~ ^"has"
  ~ ^"this" ~ ^"ability"
}
copy_exception_with_quoted_triggered_ability = {
    "," ~ ^"except" ~ ^"it" ~ ^"doesn't" ~ ^"copy" ~ ^"that"
  ~ permanent_type ~ "'s" ~ ^"color" ~ ^"and" ~ ^"it" ~ ^"has"
  ~ quoted_triggered_ability
}

static_effect_doesnt_remove_this_aura = {
    ^"this" ~ ^"effect" ~ ^"doesn't" ~ ^"remove" ~ ^"this" ~ ^"aura" ~ "."
}

static_source_attacks_each_combat_if_able = {
    source_object ~ ^"attacks" ~ ^"each" ~ ^"combat" ~ ^"if" ~ ^"able" ~ "."
}

static_source_cant_attack_unless_defending_player_controls_basic_land = {
