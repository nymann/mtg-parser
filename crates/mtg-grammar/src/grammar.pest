// Walking-skeleton grammar. Covers:
//   - Scryfall-style mana costs, e.g. `{2}{R}{R}`
//   - "Destroy target creature." / "Destroy all <permanent type>s."
//   - "Target player draws N cards." (N as an English word or variable)
//   - Keyword abilities (`Flying`, parameterized `Enchant <type>`, ...)
//   - Cards with multiple abilities separated by newlines
//   - Static abilities of the form
//       "As long as <cond>, <effect>."
//     where <effect> is a type-changing continuous effect on the
//     enchanted permanent (the Animate Artifact shape).
//
// Whitespace within an ability is implicit between tokens in
// non-atomic rules. `WHITESPACE` is just " " so newlines are never
// consumed implicitly — they act as ability separators at the top
// level.

WHITESPACE = _{ " " }

card_text = { SOI ~ (modal_choice | abilities) ~ EOI }

// Card text is a list of printed lines (paragraphs) separated by '\n'.
// Each line is either a single "phrase" ability (no terminating period,
// e.g. `Flying`, `Enchant creature`) or a chain of one or more
// "sentence" abilities (each ending in a period, e.g. two triggered
// abilities printed in a single line as on Animate Dead).
abilities = _{ line ~ ("\n" ~ line)* }
line      = _{ sentence_chain | phrase_statement }

// `+` plus implicit whitespace handles same-line chaining (Animate
// Dead's two triggers on one printed line, e.g.
// `... to it. When this Aura leaves ...`). Phrase statements like
// `Flying` or `{R}` aren't in this chain, which is what stops
// `parse("{2} {R}")` from silently accepting two mana costs.
sentence_chain     = _{ sentence_statement+ }
sentence_statement = _{
    modal_mode
  | cast_restriction
  | this_spell_costs_mana_more_to_cast_for_each_target_beyond_the_first
  | ante_play_restriction
  | you_own_target_card_in_zone
  | exchange_that_card_with_top_card_of_your_library
  | imperative_action_sequence
  | counter_target_spell
  | destroy_all_basic_lands
  | destroy_all
  | destroy_target_permanent_choice
  | destroy
  | regenerate_target_creature
  | named_source_deals_variable_damage_divided_evenly_rounded_down_among_any_number_of_targets
  | named_source_deals_variable_damage_to_damage_recipients
  | named_source_deals_variable_damage_to_any_target
  | prevent_all_combat_damage_this_turn
  | spend_only_color_mana_on_variable
  | you_gain_life_equal_damage_dealt_capped
  | if_its_permanent_cant_be_regenerated_and_would_die_exile_instead_this_turn
  | target_player_activates_mana_ability_of_each_permanent_they_control
  | then_that_player_loses_unspent_mana_and_you_add_mana_lost_this_way
  | draw_cards
  | add_mana
  | until_eot_you_may_pay_cost_at_timing
  // Gain-life must precede add-mana because both share the "If you do," prefix.
  | if_you_do_gain_life
  | if_you_do_add_mana
  | if_this_ability_activated_at_least_times_this_turn_sacrifice_source_at_next_end_step
  | target_spell_or_permanent_becomes_color
  | target_permanent_gains_keyword_and_gets_eot
  | each_player_performs_action
  | remove_target_creature_defending_player_controls_from_combat
  | creatures_it_was_blocking_become_unblocked
  | you_may_have_it_block_attacking_creature
  | target_creature_defending_player_controls_can_block_any_number
  | it_blocks_each_attacking_creature_if_able
  | this_turn_defending_players_make_random_blocking_piles
  | additional_blockers_may_be_put_into_additional_piles
  | assign_each_pile_to_attacking_creature_at_random
  | creatures_in_assigned_pile_block_if_able
  | as_this_permanent_enters_choose_opponent
  | activated_ability
  | static_as_long_as
  | static_colored_permanents_get
  | static_status_creatures_you_control_get
  | static_enchanted_gets
  | static_enchanted_gets_with_definitions
  | static_enchanted_has_triggered_ability
  | static_enchanted_has_keyword_and_cant_be_enchanted_by_other_auras
  | static_enchanted_has_keyword
  | static_enchanted_loses_keyword
  | static_enchanted_is_basic_land_type
  | static_enchanted_can_attack_as_though
  | static_you_control_enchanted
  | static_you_may_play_any_number_of_permanents_on_each_of_your_turns
  | static_you_may_have_source_enter_as_copy
  | static_source_doesnt_untap_during_your_untap_step
  | static_effect_doesnt_remove_this_aura
  | static_basic_lands_are_basic_lands
  | static_that_permanent_is_basic_land_type_while_has_named_counter
  | triggered_ability_fragment
  | triggered_ability
  | physical_action
  | each_player_equalizes_controlled_permanents
  | players_do_actions_the_same_way
  | source_enters_with_pt_counters
  | this_ability_cant_cause_total_pt_counters_greater_than
  | activate_only_during_your_upkeep
  | activate_only_during_your_turn
}

phrase_statement = _{
    modal_choice
  | mana_cost
  | keyword_ability
  | triggered_ability_fragment
  | static_enchanted_loses_keyword_fragment
}

// Modal spells print a choice header followed by bullet-pointed modes.
// The header alone and each bullet alone are accepted for generated
// pattern tests, but the canonical full-card AST is one modal choice.
modal_choice = { choose_one ~ ("\n" ~ modal_mode)* }
choose_one    = { ^"choose" ~ ^"one" ~ "—" }
modal_mode    = { "•" ~ modal_effect }
modal_effect  = _{ counter_target_colored_spell | destroy_target_colored_permanent }
counter_target_colored_spell = {
    ^"counter" ~ ^"target" ~ color_word ~ ^"spell" ~ "."
}
destroy_target_colored_permanent = {
    ^"destroy" ~ ^"target" ~ color_word ~ ^"permanent" ~ "."
}

mana_cost   = ${ mana_symbol+ }
mana_symbol = ${ "{" ~ mana_body ~ "}" }
mana_body   = _{ generic | color }
generic     = @{ ASCII_DIGIT+ }
color       = @{ "W" | "U" | "B" | "R" | "G" | "C" }
tap_symbol  = ${ "{" ~ "T" ~ "}" }

this_spell_costs_mana_more_to_cast_for_each_target_beyond_the_first = {
    ^"this" ~ ^"spell" ~ ^"costs" ~ mana_cost ~ ^"more" ~ ^"to"
  ~ ^"cast" ~ ^"for" ~ ^"each" ~ ^"target" ~ ^"beyond" ~ ^"the"
  ~ ^"first" ~ "."
}

destroy = { ^"destroy" ~ ^"target" ~ ^"creature" ~ "." }
destroy_all_basic_lands = { ^"destroy" ~ ^"all" ~ basic_land_type_plural ~ "." }
destroy_all = { ^"destroy" ~ ^"all" ~ permanent_type_plural ~ "." }
destroy_target_permanent_choice = { ^"destroy" ~ ^"target" ~ permanent_type ~ (^"or" ~ permanent_type)+ ~ "." }
counter_target_spell = { ^"counter" ~ ^"target" ~ ^"spell" ~ "." }
regenerate_target_creature = { ^"regenerate" ~ ^"target" ~ ^"creature" ~ "." }

named_source_deals_variable_damage_divided_evenly_rounded_down_among_any_number_of_targets = {
    proper_name ~ ^"deals" ~ variable_name ~ ^"damage" ~ ^"divided"
  ~ ^"evenly" ~ "," ~ ^"rounded" ~ ^"down" ~ "," ~ ^"among"
  ~ ^"any" ~ ^"number" ~ ^"of" ~ ^"targets" ~ "."
}
named_source_deals_variable_damage_to_any_target = {
    proper_name ~ ^"deals" ~ variable_name ~ ^"damage" ~ ^"to" ~ ^"any" ~ ^"target" ~ "."
}
named_source_deals_variable_damage_to_damage_recipients = {
    proper_name ~ ^"deals" ~ variable_name ~ ^"damage" ~ ^"to"
  ~ damage_recipient ~ (^"and" ~ damage_recipient)+ ~ "."
}
prevent_all_combat_damage_this_turn = {
    ^"prevent" ~ ^"all" ~ ^"combat" ~ ^"damage" ~ ^"that"
  ~ ^"would" ~ ^"be" ~ ^"dealt" ~ ^"this" ~ ^"turn" ~ "."
}
damage_recipient = { each_creature_without_keyword | each_player_damage_recipient }
each_creature_without_keyword = { ^"each" ~ ^"creature" ~ ^"without" ~ keyword }
each_player_damage_recipient = { ^"each" ~ ^"player" }
proper_name = @{ upper_alpha ~ (ASCII_ALPHANUMERIC | "'" | "-")* ~ (WHITESPACE ~ upper_alpha ~ (ASCII_ALPHANUMERIC | "'" | "-")*)* }
upper_alpha = _{ 'A'..'Z' }

spend_only_color_mana_on_variable = {
    ^"spend" ~ ^"only" ~ color_word ~ ^"mana" ~ ^"on" ~ variable_name ~ "."
}

you_gain_life_equal_damage_dealt_capped = {
    ^"you" ~ ^"gain" ~ ^"life" ~ ^"equal" ~ ^"to" ~ ^"the"
  ~ ^"damage" ~ ^"dealt" ~ "," ~ ^"but" ~ ^"not" ~ ^"more"
  ~ ^"life" ~ ^"than" ~ damage_life_gain_cap
  ~ ("," ~ damage_life_gain_cap)* ~ ","? ~ ^"or" ~ damage_life_gain_cap ~ "."
}

damage_life_gain_cap = _{
    player_life_total_before_damage_dealt
  | planeswalker_loyalty_before_damage_dealt
  | creature_toughness
}
player_life_total_before_damage_dealt = {
    ^"the" ~ ^"player's" ~ ^"life" ~ ^"total" ~ ^"before"
  ~ ^"the" ~ ^"damage" ~ ^"was" ~ ^"dealt"
}
planeswalker_loyalty_before_damage_dealt = {
    ^"the" ~ ^"planeswalker's" ~ ^"loyalty" ~ ^"before"
  ~ ^"the" ~ ^"damage" ~ ^"was" ~ ^"dealt"
}
creature_toughness = { ^"the" ~ ^"creature's" ~ ^"toughness" }

if_its_permanent_cant_be_regenerated_and_would_die_exile_instead_this_turn = {
    ^"if" ~ ^"it's" ~ article ~ permanent_type ~ "," ~ ^"it" ~ ^"can't"
  ~ ^"be" ~ ^"regenerated" ~ ^"this" ~ ^"turn" ~ "," ~ ^"and"
  ~ ^"if" ~ ^"it" ~ ^"would" ~ ^"die" ~ ^"this" ~ ^"turn" ~ ","
  ~ ^"exile" ~ ^"it" ~ ^"instead" ~ "."
}

draw_cards  = { ^"target" ~ ^"player" ~ ^"draws" ~ draw_count ~ ^"cards" ~ "." }
draw_count  = _{ number_word | variable_name }
number_word = @{
    ^"one" | ^"two" | ^"three" | ^"four" | ^"five"
  | ^"six" | ^"seven" | ^"eight" | ^"nine" | ^"ten"
}

target_player_activates_mana_ability_of_each_permanent_they_control = {
    ^"target" ~ ^"player" ~ ^"activates" ~ article ~ ^"mana" ~ ^"ability"
  ~ ^"of" ~ ^"each" ~ permanent_type ~ ^"they" ~ ^"control" ~ "."
}

then_that_player_loses_unspent_mana_and_you_add_mana_lost_this_way = {
    ^"then" ~ ^"that" ~ ^"player" ~ ^"loses" ~ ^"all" ~ ^"unspent"
  ~ ^"mana" ~ ^"and" ~ ^"you" ~ ^"add" ~ ^"the" ~ ^"mana"
  ~ ^"lost" ~ ^"this" ~ ^"way" ~ "."
}

ante_play_restriction = {
    ^"remove" ~ ^"this" ~ ^"card" ~ ^"from" ~ ^"your" ~ ^"deck"
  ~ ^"before" ~ ^"playing" ~ ^"if" ~ ^"you're" ~ ^"not"
  ~ ^"playing" ~ ^"for" ~ ^"ante" ~ "."
}

you_own_target_card_in_zone = {
    ^"you" ~ ^"own" ~ ^"target" ~ ^"card" ~ ^"in" ~ ^"the" ~ zone ~ "."
}

exchange_that_card_with_top_card_of_your_library = {
    ^"exchange" ~ ^"that" ~ ^"card" ~ ^"with" ~ ^"the" ~ ^"top"
  ~ ^"card" ~ ^"of" ~ ^"your" ~ ^"library" ~ "."
}

imperative_action_sequence = {
    imperative_action ~ ("," ~ imperative_action)* ~ "," ~ ^"then" ~ imperative_action ~ "."
}

imperative_action = _{
    discard_your_hand_action
  | ante_top_card_of_your_library_action
  | search_your_library_for_a_card_action
  | put_that_card_into_your_hand_action
  | shuffle_action
  | draw_cards_action
  | tap_source_action
  | sacrifice_permanent_of_opponents_choice_action
}
discard_your_hand_action = { ^"discard" ~ ^"your" ~ ^"hand" }
ante_top_card_of_your_library_action = {
    ^"ante" ~ ^"the" ~ ^"top" ~ ^"card" ~ ^"of" ~ ^"your" ~ ^"library"
}
search_your_library_for_a_card_action = {
    ^"search" ~ ^"your" ~ ^"library" ~ ^"for" ~ article ~ ^"card"
}
put_that_card_into_your_hand_action = {
    ^"put" ~ ^"that" ~ ^"card" ~ ^"into" ~ ^"your" ~ ^"hand"
}
shuffle_action = { ^"shuffle" }
draw_cards_action = { ^"draw" ~ draw_count ~ ^"cards" }
tap_source_action = { ^"tap" ~ source_object }
sacrifice_permanent_of_opponents_choice_action = {
    ^"sacrifice" ~ article ~ permanent_type ~ ^"of" ~ article ~ ^"opponent's" ~ ^"choice"
}

each_player_performs_action = {
    ^"each" ~ ^"player" ~ each_player_action ~ "."
}
each_player_action = _{ each_player_antes_top_card_of_their_library_action }
each_player_antes_top_card_of_their_library_action = {
    ^"antes" ~ ^"the" ~ ^"top" ~ ^"card" ~ ^"of" ~ ^"their" ~ ^"library"
}

until_eot_you_may_pay_cost_at_timing = {
    ^"until" ~ ^"end" ~ ^"of" ~ ^"turn" ~ "," ~ action_timing
  ~ "," ~ ^"you" ~ ^"may" ~ optional_cost ~ "."
}

action_timing = _{ any_time_you_could_activate_a_mana_ability }
any_time_you_could_activate_a_mana_ability = {
    ^"any" ~ ^"time" ~ ^"you" ~ ^"could" ~ ^"activate" ~ article
  ~ ^"mana" ~ ^"ability"
}

optional_cost = _{ pay_life_cost }
pay_life_cost = { ^"pay" ~ unsigned_number ~ ^"life" }

if_you_do_add_mana = { ^"if" ~ ^"you" ~ ^"do" ~ "," ~ add_mana }
if_you_do_gain_life = {
    ^"if" ~ ^"you" ~ ^"do" ~ "," ~ ^"you" ~ ^"gain" ~ unsigned_number ~ ^"life" ~ "."
}

// Balance-style resource equalization:
// each player keeps a count of objects matching the least-stocked player,
// then follow-up actions can apply "the same way" to other resources.
each_player_equalizes_controlled_permanents = {
    ^"each" ~ ^"player" ~ ^"chooses" ~ article ~ ^"number" ~ ^"of"
  ~ permanent_type_plural ~ ^"they" ~ ^"control" ~ ^"equal" ~ ^"to"
  ~ ^"the" ~ ^"number" ~ ^"of" ~ permanent_type_plural ~ ^"controlled"
  ~ ^"by" ~ ^"the" ~ ^"player" ~ ^"who" ~ ^"controls" ~ ^"the"
  ~ ^"fewest" ~ "," ~ ^"then" ~ ^"sacrifices" ~ ^"the" ~ ^"rest" ~ "."
}

players_do_actions_the_same_way = {
    ^"players" ~ balance_same_way_action
  ~ (^"and" ~ balance_same_way_action)*
  ~ ^"the" ~ ^"same" ~ ^"way" ~ "."
}

as_this_permanent_enters_choose_opponent = {
    ^"as" ~ source_object ~ ^"enters" ~ "," ~ ^"choose" ~ article ~ ^"opponent" ~ "."
}

balance_same_way_action = _{ discard_cards_action | sacrifice_permanents_action }
discard_cards_action = { ^"discard" ~ ^"cards" }
sacrifice_permanents_action = { ^"sacrifice" ~ permanent_type_plural }

keyword_ability = { keyword }
keyword         = _{ enchant | first_strike | protection | flying | defender | banding | trample | mountainwalk | swampwalk | indestructible | fear }
first_strike    = { ^"first" ~ ^"strike" }
protection      = { ^"protection" ~ ^"from" ~ color_word }
flying          = @{ ^"flying" }
defender        = @{ ^"defender" }
banding         = @{ ^"banding" }
trample         = @{ ^"trample" }
mountainwalk    = @{ ^"mountainwalk" }
swampwalk       = @{ ^"swampwalk" }
indestructible  = @{ ^"indestructible" }
fear            = @{ ^"fear" }

cast_restriction = {
    ^"cast" ~ ^"this" ~ ^"spell" ~ ^"only" ~ cast_timing ~ "."
}
before_step = { ^"before" ~ ^"the" ~ step ~ ^"step" }
during_step = { ^"during" ~ ^"the" ~ step ~ ^"step" }
during_your_step = { ^"during" ~ ^"your" ~ step ~ ^"step" }
// Factor the shared `declare` prefix so declare-step names don't shadow
// each other under PEG's ordered matching.
step = { ^"combat" ~ ^"damage" | ^"declare" ~ (^"attackers" | ^"blockers") }
cast_timing = _{ during_combat_before_blockers_declared | during_your_step | during_step | before_step }
during_combat_before_blockers_declared = {
    ^"during" ~ ^"combat" ~ ^"before" ~ ^"blockers" ~ ^"are" ~ ^"declared"
}

// `Enchant <object>`. Order the longer alternatives first so PEG's
// first-match doesn't stop at the bare permanent type.
enchant = {
    ^"enchant"
  ~ (enchant_put_onto_battlefield | enchant_card_in_zone | enchant_permanent | enchant_creature_type)
}
enchant_permanent    = { permanent_type }
enchant_creature_type = { creature_type }
enchant_card_in_zone = { permanent_type ~ ^"card" ~ ^"in" ~ article ~ zone }
enchant_put_onto_battlefield = {
    permanent_type ~ ^"put" ~ ^"onto" ~ ^"the" ~ ^"battlefield"
  ~ ^"with" ~ ^"this" ~ ^"aura"
}
zone = @{ ^"graveyard" | ^"ante" }

// Card types that appear as keyword arguments or in type lines.
// Atomic so each alternative is matched as a single word.
permanent_type = @{
    ^"artifact"
  | ^"creature"
  | ^"enchantment"
  | ^"land"
  | ^"planeswalker"
}

permanent_type_plural = @{
    ^"artifacts"
  | ^"creatures"
  | ^"enchantments"
  | ^"lands"
  | ^"planeswalkers"
}

color_word = @{
    ^"white"
  | ^"blue"
  | ^"black"
  | ^"red"
  | ^"green"
 }

// Creature subtypes that appear as Aura targets or enchanted objects.
creature_type = @{ ^"wall" }

// Static abilities. Five surface shapes today:
//   - "As long as <cond>, <effect>." — conditional continuous effect.
//   - "<Color> <type>s get <pt_modifier>." — P/T modifier on objects
//     matching a color and permanent type.
//   - "<Status> creatures you control get <pt_modifier>." — P/T
//     modifier on controlled creatures matching a tapped/untapped state.
//   - "Enchanted <type> gets <pt_modifier>." — unconditional P/T
//     modifier on the enchanted permanent (e.g. Animate Dead).
//   - "Enchanted <type> gets <variable_pt_modifier>, where ..." — a
//     variable P/T modifier with printed definitions for those variables.
//   - "Enchanted <object> has <keyword>." — keyword-granting effect on
//     the enchanted object.
//   - "Enchanted <object> has <keyword> and can't be enchanted by other
//     Auras." — keyword-granting effect plus an Aura attachment
//     restriction on the enchanted object.
//   - "Enchanted <object> can attack as though it didn't have
//     <keyword>." — permission effect that ignores an attack restriction.
//   - "You control enchanted <object>." — continuous control-changing
//     effect from an Aura to its enchanted object.
//   - "You may have this <type> enter as a copy of any <type> on the
//     battlefield." — optional as-enters copy replacement effect.
//   - "This effect doesn't remove this Aura." — effect-continuity text
//     that preserves the Aura while applying the preceding static effect.
static_ability = _{
    static_as_long_as
  | static_colored_permanents_get
  | static_status_creatures_you_control_get
  | static_enchanted_gets
  | static_enchanted_gets_with_definitions
  | static_enchanted_has_triggered_ability
  | static_enchanted_has_keyword_and_cant_be_enchanted_by_other_auras
  | static_enchanted_has_keyword
  | static_enchanted_loses_keyword
  | static_enchanted_is_basic_land_type
  | static_enchanted_can_attack_as_though
  | static_you_control_enchanted
  | static_you_may_play_any_number_of_permanents_on_each_of_your_turns
  | static_you_may_have_source_enter_as_copy
  | static_effect_doesnt_remove_this_aura
  | static_basic_lands_are_basic_lands
  | static_that_permanent_is_basic_land_type_while_has_named_counter
}

static_as_long_as = {
    ^"as" ~ ^"long" ~ ^"as" ~ condition ~ "," ~ continuous_effect ~ "."
}

static_colored_permanents_get = {
    color_word ~ permanent_type_plural ~ ^"get" ~ pt_modifier ~ "."
}

static_status_creatures_you_control_get = {
    creature_status ~ ^"creatures" ~ ^"you" ~ ^"control" ~ ^"get" ~ pt_modifier ~ "."
}

creature_status = @{ ^"tapped" | ^"untapped" }

static_enchanted_gets = {
    ^"enchanted" ~ permanent_type ~ ^"gets" ~ pt_modifier ~ "."
}

static_enchanted_gets_with_definitions = {
    ^"enchanted" ~ permanent_type ~ ^"gets" ~ variable_pt_modifier
  ~ "," ~ where_clause ~ "."
}

static_enchanted_has_keyword = {
    ^"enchanted" ~ enchanted_object ~ ^"has" ~ keyword ~ "."
}

static_enchanted_has_triggered_ability = {
    ^"enchanted" ~ enchanted_object ~ ^"has" ~ quoted_triggered_ability
}

static_enchanted_loses_keyword = {
    ^"enchanted" ~ enchanted_object ~ ^"loses" ~ keyword ~ "."
}
static_enchanted_loses_keyword_fragment = {
    ^"enchanted" ~ enchanted_object ~ ^"loses" ~ keyword
}

static_enchanted_is_basic_land_type = {
    ^"enchanted" ~ enchanted_object ~ ^"is" ~ article ~ basic_land_type ~ "."
}

static_enchanted_has_keyword_and_cant_be_enchanted_by_other_auras = {
    ^"enchanted" ~ enchanted_object ~ ^"has" ~ keyword ~ ^"and" ~ ^"can't"
  ~ ^"be" ~ ^"enchanted" ~ ^"by" ~ ^"other" ~ ^"auras" ~ "."
}

static_enchanted_can_attack_as_though = {
    ^"enchanted" ~ enchanted_object ~ ^"can" ~ ^"attack"
  ~ ^"as" ~ ^"though" ~ ^"it" ~ ^"didn't" ~ ^"have" ~ keyword ~ "."
}

static_you_control_enchanted = {
    ^"you" ~ ^"control" ~ ^"enchanted" ~ enchanted_object ~ "."
}

static_you_may_play_any_number_of_permanents_on_each_of_your_turns = {
    ^"you" ~ ^"may" ~ ^"play" ~ ^"any" ~ ^"number" ~ ^"of"
  ~ permanent_type_plural ~ ^"on" ~ ^"each" ~ ^"of" ~ ^"your" ~ ^"turns" ~ "."
}

static_you_may_have_source_enter_as_copy = {
    ^"you" ~ ^"may" ~ ^"have" ~ source_object ~ ^"enter"
  ~ ^"as" ~ article ~ ^"copy" ~ ^"of" ~ ^"any" ~ permanent_type
  ~ ^"on" ~ ^"the" ~ ^"battlefield" ~ copy_exception? ~ "."
}

copy_exception = {
    "," ~ ^"except" ~ ^"it's" ~ article ~ permanent_type
  ~ ^"in" ~ ^"addition" ~ ^"to" ~ ^"its" ~ ^"other" ~ ^"types"
}

static_effect_doesnt_remove_this_aura = {
    ^"this" ~ ^"effect" ~ ^"doesn't" ~ ^"remove" ~ ^"this" ~ ^"aura" ~ "."
}

static_basic_lands_are_basic_lands = {
    ^"all" ~ basic_land_type_plural ~ ^"are" ~ basic_land_type_plural ~ "."
}

static_that_permanent_is_basic_land_type_while_has_named_counter = {
    ^"that" ~ permanent_type ~ ^"is" ~ article ~ basic_land_type
  ~ ^"for" ~ ^"as" ~ ^"long" ~ ^"as" ~ ^"it" ~ ^"has"
  ~ article ~ named_counter ~ ^"on" ~ ^"it" ~ "."
}

static_source_doesnt_untap_during_your_untap_step = {
    source_object ~ ^"doesn't" ~ ^"untap" ~ ^"during" ~ ^"your"
  ~ ^"untap" ~ ^"step" ~ "."
}

target_creature_defending_player_controls_can_block_any_number = {
    ^"target" ~ ^"creature" ~ ^"defending" ~ ^"player" ~ ^"controls"
  ~ ^"can" ~ ^"block" ~ ^"any" ~ ^"number" ~ ^"of" ~ ^"creatures"
  ~ ^"this" ~ ^"turn" ~ "."
}

remove_target_creature_defending_player_controls_from_combat = {
    ^"remove" ~ ^"target" ~ ^"creature" ~ ^"defending" ~ ^"player"
  ~ ^"controls" ~ ^"from" ~ ^"combat" ~ "."
}

creatures_it_was_blocking_become_unblocked = {
    ^"creatures" ~ ^"it" ~ ^"was" ~ ^"blocking" ~ ^"that" ~ ^"had"
  ~ ^"become" ~ ^"blocked" ~ ^"by" ~ ^"only" ~ ^"that" ~ ^"creature"
  ~ ^"this" ~ ^"combat" ~ ^"become" ~ ^"unblocked" ~ "."
}

you_may_have_it_block_attacking_creature = {
    ^"you" ~ ^"may" ~ ^"have" ~ ^"it" ~ ^"block" ~ article
  ~ ^"attacking" ~ ^"creature" ~ ^"of" ~ ^"your" ~ ^"choice" ~ "."
}

it_blocks_each_attacking_creature_if_able = {
    ^"it" ~ ^"blocks" ~ ^"each" ~ ^"attacking" ~ ^"creature"
  ~ ^"this" ~ ^"turn" ~ ^"if" ~ ^"able" ~ "."
}

this_turn_defending_players_make_random_blocking_piles = {
    ^"this" ~ ^"turn" ~ "," ~ ^"instead" ~ ^"of" ~ ^"declaring" ~ ^"blockers"
  ~ "," ~ ^"each" ~ ^"defending" ~ ^"player" ~ ^"chooses" ~ ^"any"
  ~ ^"number" ~ ^"of" ~ ^"creatures" ~ ^"they" ~ ^"control" ~ ^"and"
  ~ ^"divides" ~ ^"them" ~ ^"into" ~ article ~ ^"number" ~ ^"of"
  ~ ^"piles" ~ ^"equal" ~ ^"to" ~ ^"the" ~ ^"number" ~ ^"of"
  ~ ^"attacking" ~ ^"creatures" ~ ^"for" ~ ^"whom" ~ ^"that"
  ~ ^"player" ~ ^"is" ~ ^"the" ~ ^"defending" ~ ^"player" ~ "."
}

additional_blockers_may_be_put_into_additional_piles = {
    ^"creatures" ~ ^"those" ~ ^"players" ~ ^"control" ~ ^"that"
  ~ ^"can" ~ ^"block" ~ ^"additional" ~ ^"creatures" ~ ^"may"
  ~ ^"likewise" ~ ^"be" ~ ^"put" ~ ^"into" ~ ^"additional" ~ ^"piles" ~ "."
}

assign_each_pile_to_attacking_creature_at_random = {
    ^"assign" ~ ^"each" ~ ^"pile" ~ ^"to" ~ article ~ ^"different"
  ~ ^"one" ~ ^"of" ~ ^"those" ~ ^"attacking" ~ ^"creatures"
  ~ ^"at" ~ ^"random" ~ "."
}

creatures_in_assigned_pile_block_if_able = {
    ^"each" ~ ^"creature" ~ ^"in" ~ article ~ ^"pile" ~ ^"that"
  ~ ^"can" ~ ^"block" ~ ^"the" ~ ^"creature" ~ ^"that" ~ ^"pile"
  ~ ^"is" ~ ^"assigned" ~ ^"to" ~ ^"does" ~ ^"so" ~ "."
}

enchanted_object = _{ permanent_type | creature_type }

// Activated abilities have a printed cost before the colon and one or
// more effects after it. The cost pieces are kept explicit because tap
// symbols are costs but not mana symbols.
activated_ability = { activated_cost ~ ":" ~ activated_effect }
// Multiple non-mana activated costs are printed comma-separated.
activated_cost = { activated_cost_component ~ ("," ~ activated_cost_component)* }
activated_cost_component = _{ sacrifice_source | variable_mana_symbol | mana_cost | tap_symbol }
activated_effect = _{
    add_mana_of_any_one_color
  | add_one_mana_of_any_color
  | add_mana
  | regenerate_source
  | destroy_target_creature_type
  | destroy_target_permanent
  | counter_target_colored_spell
  | untap_source
  | target_player_discards_cards
  | target_creature_with_power_or_less_cant_be_blocked
  | activated_source_gets_until_eot
  | activated_enchanted_gets_until_eot
  | prevent_next_damage_from_colored_source
  | prevent_next_damage_to_you_this_turn
  | put_up_to_variable_pt_counters_on_source
  | put_named_counter_on_target_non_basic_land
  | physical_action
}
add_mana_of_any_one_color = {
    ^"add" ~ number_word ~ ^"mana" ~ ^"of" ~ ^"any" ~ ^"one" ~ ^"color" ~ "."
}
add_one_mana_of_any_color = { ^"add" ~ ^"one" ~ ^"mana" ~ ^"of" ~ ^"any" ~ ^"color" ~ "." }
add_mana = { ^"add" ~ mana_cost ~ "." }
regenerate_source = { ^"regenerate" ~ source_object ~ "." }
destroy_target_creature_type = { ^"destroy" ~ ^"target" ~ creature_type ~ "." }
destroy_target_permanent = { ^"destroy" ~ ^"target" ~ permanent_type ~ "." }
untap_source = { ^"untap" ~ source_object ~ "." }
target_player_discards_cards = {
    ^"target" ~ ^"player" ~ ^"discards"
  ~ (discard_one_card | discard_counted_cards) ~ "."
}
discard_one_card = { article ~ ^"card" }
discard_counted_cards = { draw_count ~ ^"cards" }
target_creature_with_power_or_less_cant_be_blocked = {
    ^"target" ~ ^"creature" ~ ^"with" ~ ^"power" ~ unsigned_number
  ~ ^"or" ~ ^"less" ~ ^"can't" ~ ^"be" ~ ^"blocked"
  ~ ^"this" ~ ^"turn" ~ "."
}
activated_source_gets_until_eot = {
    source_object ~ ^"gets" ~ pt_modifier ~ ^"until" ~ ^"end" ~ ^"of" ~ ^"turn" ~ "."
}
activated_enchanted_gets_until_eot = {
    ^"enchanted" ~ permanent_type ~ ^"gets" ~ pt_modifier
  ~ ^"until" ~ ^"end" ~ ^"of" ~ ^"turn" ~ "."
}
prevent_next_damage_from_colored_source = {
    ^"the" ~ ^"next" ~ ^"time" ~ article ~ color_word ~ ^"source"
  ~ ^"of" ~ ^"your" ~ ^"choice" ~ ^"would" ~ ^"deal" ~ ^"damage"
  ~ ^"to" ~ ^"you" ~ ^"this" ~ ^"turn" ~ "," ~ ^"prevent"
  ~ ^"that" ~ ^"damage" ~ "."
}
prevent_next_damage_to_you_this_turn = {
    ^"prevent" ~ ^"the" ~ ^"next" ~ unsigned_number ~ ^"damage"
  ~ ^"that" ~ ^"would" ~ ^"be" ~ ^"dealt" ~ ^"to" ~ ^"you"
  ~ ^"this" ~ ^"turn" ~ "."
}
put_up_to_variable_pt_counters_on_source = {
    ^"put" ~ ^"up" ~ ^"to" ~ variable_name ~ pt_counters
  ~ ^"on" ~ source_object ~ "."
}
put_named_counter_on_target_non_basic_land = {
    ^"put" ~ article ~ named_counter ~ ^"on" ~ ^"target" ~ non_basic_land_type ~ permanent_type ~ "."
}
variable_mana_symbol = ${ "{" ~ variable_name ~ "}" }
sacrifice_source = { ^"sacrifice" ~ source_object }

physical_action = _{
    if_source_on_battlefield_flip_onto_battlefield_from_height
  | if_source_turns_over_destroy_touched_nontoken_permanents
  | then_destroy_source
}

if_source_on_battlefield_flip_onto_battlefield_from_height = {
    ^"if" ~ source_object ~ ^"is" ~ ^"on" ~ ^"the" ~ ^"battlefield"
  ~ "," ~ ^"flip" ~ ^"it" ~ ^"onto" ~ ^"the" ~ ^"battlefield"
  ~ ^"from" ~ article ~ ^"height" ~ ^"of" ~ ^"at" ~ ^"least"
  ~ number_word ~ physical_height_unit ~ "."
}

if_source_turns_over_destroy_touched_nontoken_permanents = {
    ^"if" ~ source_object ~ ^"turns" ~ ^"over" ~ ^"completely"
  ~ ^"at" ~ ^"least" ~ ^"once" ~ ^"during" ~ ^"the" ~ ^"flip"
  ~ "," ~ ^"destroy" ~ ^"all" ~ ^"nontoken" ~ ^"permanents"
  ~ ^"it" ~ ^"touches" ~ "."
}

then_destroy_source = {
    ^"then" ~ ^"destroy" ~ source_object ~ "."
}

physical_height_unit = @{ ^"feet" | ^"foot" }

condition      = _{ enchanted_isnt }
enchanted_isnt = {
    ^"enchanted" ~ permanent_type ~ ^"isn't" ~ article ~ permanent_type
}

continuous_effect       = _{ becomes_pt_from_mv }
becomes_pt_from_mv = {
    ^"it's" ~ article ~ permanent_type+
  ~ ^"with" ~ ^"power" ~ ^"and" ~ ^"toughness"
  ~ ^"each" ~ ^"equal" ~ ^"to" ~ ^"its" ~ ^"mana" ~ ^"value"
}

// "+1/+1", "-1/-0", "+0/-2" — sign is always explicit on both sides.
pt_modifier   = ${ signed_number ~ "/" ~ signed_number }
signed_number = @{ ("+" | "-") ~ ASCII_DIGIT+ }
pt_counter    = { pt_modifier ~ ^"counter" }
pt_counters   = { pt_modifier ~ ^"counters" }

// "+X/+Y, where X is ..." — sign is explicit on both variables, and
// the variable definitions carry the arithmetic printed after "where".
variable_pt_modifier = { signed_variable ~ "/" ~ signed_variable }
signed_variable      = @{ ("+" | "-") ~ variable_name }
variable_name        = @{ "X" | "Y" }

mixed_pt_modifier = { signed_pt_component ~ "/" ~ signed_pt_component }
signed_pt_component = _{ signed_variable | signed_number }

where_clause         = { ^"where" ~ variable_definition ~ ("," ~ ^"and" ~ variable_definition)? }
variable_definition  = { variable_name ~ ^"is" ~ value_expression }
value_expression     = _{
    half_number_of_basic_lands_you_control
  | number_of_cards_in_their_hand_minus
  | its_power
}
half_number_of_basic_lands_you_control = {
    ^"half" ~ ^"the" ~ ^"number" ~ ^"of" ~ basic_land_type_plural
  ~ ^"you" ~ ^"control" ~ "," ~ rounding
}
number_of_cards_in_their_hand_minus = {
    ^"the" ~ ^"number" ~ ^"of" ~ ^"cards" ~ ^"in" ~ ^"their"
  ~ ^"hand" ~ ^"minus" ~ unsigned_number
}
its_power = { ^"its" ~ ^"power" }
unsigned_number = @{ ASCII_DIGIT+ }
rounding = { ^"rounded" ~ rounding_direction }
rounding_direction = @{ ^"down" | ^"up" }
basic_land_type_plural = @{
    ^"plains"
  | ^"islands"
  | ^"swamps"
  | ^"mountains"
  | ^"forests"
}
basic_land_type = @{
    ^"plains"
  | ^"island"
  | ^"swamp"
  | ^"mountain"
  | ^"forest"
}
non_basic_land_type = { ^"non-" ~ basic_land_type }
named_counter = { counter_name ~ ^"counter" }
named_counters = { counter_name ~ ^"counters" }
counter_name = @{ ASCII_ALPHA+ }

// "When <event>, [if <cond>,] <effect>+"
// Each trigger_effect rule below carries its own terminator (a closing
// "." or a closing quote that absorbs a period). Effects are then just
// space-separated within the trigger; no ". " separator is needed at
// this layer.
triggered_ability = {
    trigger_word ~ trigger_event ~ ","
  ~ (^"if" ~ intervening_if ~ ",")?
  ~ trigger_effect ~ (^"and"? ~ trigger_effect)*
}

triggered_ability_fragment = {
    trigger_word ~ trigger_event ~ ","
  ~ you_may_pay_mana ~ if_you_do_gain_life_fragment ~ !"."
}

// "Whenever" is listed first because "When" is its prefix.
trigger_word = _{ ^"whenever" | ^"when" | ^"at" }

trigger_event = _{
    permanent_put_into_graveyard_from_battlefield
  | source_put_into_graveyard_from_battlefield
  | aura_leaves_battlefield
  | aura_enters
  | enchanted_permanent_dies
  | source_blocks_or_becomes_blocked_by_non_creature_type_creature
  | end_of_combat
  | beginning_of_each_players_upkeep
  | beginning_of_your_upkeep
  | beginning_of_upkeep_of_enchanted_permanent_controller
  | beginning_of_chosen_players_upkeep
  | beginning_of_the_next_end_step
  | you_play_permanent
  | player_casts_colored_spell
  | permanent_enters
}
aura_enters             = { ^"this" ~ ^"aura" ~ ^"enters" }
aura_leaves_battlefield = { ^"this" ~ ^"aura" ~ ^"leaves" ~ ^"the" ~ ^"battlefield" }
source_put_into_graveyard_from_battlefield = {
    source_object ~ ^"is" ~ ^"put" ~ ^"into" ~ article ~ zone
  ~ ^"from" ~ ^"the" ~ ^"battlefield"
}
permanent_put_into_graveyard_from_battlefield = {
    article ~ permanent_type ~ ^"is" ~ ^"put" ~ ^"into" ~ article ~ zone
  ~ ^"from" ~ ^"the" ~ ^"battlefield"
}
enchanted_permanent_dies = { ^"enchanted" ~ permanent_type ~ ^"dies" }
permanent_enters        = { article ~ permanent_type ~ ^"enters" }
player_casts_colored_spell = { article ~ ^"player" ~ ^"casts" ~ article ~ color_word ~ ^"spell" }
you_play_permanent = { ^"you" ~ ^"play" ~ article ~ permanent_type }
source_blocks_or_becomes_blocked_by_non_creature_type_creature = {
    source_object ~ ^"blocks" ~ ^"or" ~ ^"becomes" ~ ^"blocked"
  ~ ^"by" ~ article ~ ^"non-" ~ creature_type ~ ^"creature"
}
end_of_combat           = { ^"end" ~ ^"of" ~ ^"combat" }
beginning_of_the_next_end_step = {
    ^"the" ~ ^"beginning" ~ ^"of" ~ ^"the" ~ ^"next" ~ ^"end" ~ ^"step"
}
beginning_of_chosen_players_upkeep = {
    ^"the" ~ ^"beginning" ~ ^"of" ~ ^"the" ~ ^"chosen" ~ ^"player's" ~ ^"upkeep"
}
beginning_of_each_players_upkeep = {
    ^"the" ~ ^"beginning" ~ ^"of" ~ ^"each" ~ ^"player's" ~ ^"upkeep"
}
beginning_of_your_upkeep = {
    ^"the" ~ ^"beginning" ~ ^"of" ~ ^"your" ~ ^"upkeep"
}
beginning_of_upkeep_of_enchanted_permanent_controller = {
    ^"the" ~ ^"beginning" ~ ^"of" ~ ^"the" ~ ^"upkeep" ~ ^"of"
  ~ ^"enchanted" ~ permanent_type ~ "'s" ~ ^"controller"
}

intervening_if         = _{ its_on_the_battlefield | enchanted_has_keyword | it_wasnt_first_permanent_you_played_this_turn | source_attacked_or_blocked_this_combat }
its_on_the_battlefield = { ^"it's" ~ ^"on" ~ ^"the" ~ ^"battlefield" }
enchanted_has_keyword = { ^"enchanted" ~ enchanted_object ~ ^"has" ~ keyword }
it_wasnt_first_permanent_you_played_this_turn = {
    ^"it" ~ ^"wasn't" ~ ^"the" ~ ^"first" ~ permanent_type
  ~ ^"you" ~ ^"played" ~ ^"this" ~ ^"turn"
}
source_attacked_or_blocked_this_combat = {
    source_object ~ ^"attacked" ~ ^"or" ~ ^"blocked" ~ ^"this" ~ ^"combat"
}

trigger_effect = _{
    destroy_that_creature_if_it_attacked_this_turn
  | destroy_that_creature_at_end_of_combat
  | delayed_remove_all_named_counters_from_linked_land
  | remove_pt_counter_from_it
  | loses_and_gains_keyword
  | return_enchanted_card_and_attach
  | unless_you_pay_mana_do_actions
  | you_may_pay_mana
  | if_you_do_gain_life
  | sacrifice_source_unless_you_pay
  | source_deals_damage_equal_to_that_permanents_toughness_to_the_permanents_controller
  | source_deals_variable_damage_to_that_player
  | source_deals_damage_to_you
  | source_deals_damage_to_that_player
  | source_deals_damage_to_that_permanents_controller
  | source_deals_damage_to_that_permanent
  | source_gains_static_ability
  | that_creatures_controller_sacrifices_it
}

target_permanent_gains_keyword_and_gets_eot = {
    ^"target" ~ permanent_type ~ ^"gains" ~ keyword ~ ^"and"
  ~ ^"gets" ~ mixed_pt_modifier ~ ^"until" ~ ^"end" ~ ^"of" ~ ^"turn"
  ~ "," ~ where_clause ~ "."
}

target_spell_or_permanent_becomes_color = {
    ^"target" ~ ^"spell" ~ ^"or" ~ ^"permanent" ~ ^"becomes" ~ color_word ~ "."
}

source_enters_with_pt_counters = {
    source_object ~ ^"enters" ~ ^"with" ~ number_word ~ pt_counters
  ~ ^"on" ~ ^"it" ~ "."
}

this_ability_cant_cause_total_pt_counters_greater_than = {
    ^"this" ~ ^"ability" ~ ^"can't" ~ ^"cause" ~ ^"the" ~ ^"total"
  ~ ^"number" ~ ^"of" ~ pt_counters ~ ^"on" ~ source_object
  ~ ^"to" ~ ^"be" ~ ^"greater" ~ ^"than" ~ number_word ~ "."
}

if_this_ability_activated_at_least_times_this_turn_sacrifice_source_at_next_end_step = {
    ^"if" ~ ^"this" ~ ^"ability" ~ ^"has" ~ ^"been" ~ ^"activated"
  ~ number_word ~ ^"or" ~ ^"more" ~ ^"times" ~ ^"this" ~ ^"turn"
  ~ "," ~ ^"sacrifice" ~ source_object ~ ^"at" ~ beginning_of_the_next_end_step ~ "."
}

activate_only_during_your_upkeep = {
    ^"activate" ~ ^"only" ~ ^"during" ~ ^"your" ~ ^"upkeep" ~ "."
}
activate_only_during_your_turn = {
    ^"activate" ~ ^"only" ~ ^"during" ~ ^"your" ~ ^"turn" ~ "."
}

destroy_that_creature_if_it_attacked_this_turn = {
    ^"destroy" ~ ^"that" ~ ^"creature" ~ ^"if" ~ ^"it"
  ~ ^"attacked" ~ ^"this" ~ ^"turn" ~ "."
}

destroy_that_creature_at_end_of_combat = {
    ^"destroy" ~ ^"that" ~ ^"creature" ~ ^"at" ~ ^"end" ~ ^"of" ~ ^"combat" ~ "."
}

that_creatures_controller_sacrifices_it = {
    ^"that" ~ ^"creature's" ~ ^"controller" ~ ^"sacrifices" ~ ^"it" ~ "."
}

sacrifice_source_unless_you_pay = {
    ^"sacrifice" ~ source_object ~ ^"unless" ~ ^"you" ~ ^"pay" ~ mana_cost ~ "."
}

you_may_pay_mana = { ^"you" ~ ^"may" ~ ^"pay" ~ mana_cost ~ "." }
if_you_do_gain_life_fragment = {
    ^"if" ~ ^"you" ~ ^"do" ~ "," ~ ^"you" ~ ^"gain" ~ unsigned_number ~ ^"life"
}

unless_you_pay_mana_do_actions = {
    ^"unless" ~ ^"you" ~ ^"pay" ~ mana_cost ~ ","
  ~ imperative_action ~ (^"and" ~ imperative_action)* ~ "."
}

remove_pt_counter_from_it = {
    ^"remove" ~ article ~ pt_counter ~ ^"from" ~ ^"it" ~ "."
}
delayed_remove_all_named_counters_from_linked_land = {
    ^"at" ~ ^"the" ~ ^"beginning" ~ ^"of" ~ ^"each" ~ ^"of" ~ ^"your"
  ~ ^"upkeeps" ~ ^"for" ~ ^"the" ~ ^"rest" ~ ^"of" ~ ^"the" ~ ^"game"
  ~ "," ~ ^"remove" ~ ^"all" ~ named_counters ~ ^"from" ~ article
  ~ permanent_type ~ ^"that" ~ article ~ named_counter ~ ^"was" ~ ^"put"
  ~ ^"onto" ~ ^"with" ~ source_object ~ ^"but" ~ ^"that" ~ article
  ~ named_counter ~ ^"has" ~ ^"not" ~ ^"been" ~ ^"removed" ~ ^"from"
  ~ ^"with" ~ source_object ~ "."
}

source_deals_damage_to_that_permanents_controller = {
    source_object ~ ^"deals" ~ damage_amount ~ ^"damage" ~ ^"to"
  ~ that_permanents_controller ~ "."
}
source_deals_damage_equal_to_that_permanents_toughness_to_the_permanents_controller = {
    source_object ~ ^"deals" ~ ^"damage" ~ ^"equal" ~ ^"to"
  ~ that_permanents_toughness ~ ^"to" ~ the_permanents_controller ~ "."
}
source_deals_damage_to_that_player = {
    source_object ~ ^"deals" ~ damage_amount ~ ^"damage" ~ ^"to" ~ ^"that" ~ ^"player" ~ "."
}
source_deals_damage_to_you = {
    source_object ~ ^"deals" ~ damage_amount ~ ^"damage" ~ ^"to" ~ ^"you" ~ "."
}
source_deals_damage_to_that_permanent = {
    source_object ~ ^"deals" ~ damage_amount ~ ^"damage" ~ ^"to" ~ ^"that" ~ permanent_type
}
source_deals_variable_damage_to_that_player = {
    source_object ~ ^"deals" ~ variable_name ~ ^"damage" ~ ^"to"
  ~ ^"that" ~ ^"player" ~ "," ~ where_clause ~ "."
}
source_object = { ^"this" ~ source_object_kind }
source_object_kind = _{ aura_source_object | permanent_type }
aura_source_object = { ^"aura" }
that_permanents_controller = { ^"that" ~ permanent_type ~ "'s" ~ ^"controller" }
that_permanents_toughness = { ^"that" ~ permanent_type ~ "'s" ~ ^"toughness" }
the_permanents_controller = { ^"the" ~ permanent_type ~ "'s" ~ ^"controller" }
damage_amount = @{ ASCII_DIGIT+ }

// `it loses "<keyword>" and gains "<keyword>."`. The quoted strings are
// themselves keyword abilities — recursive parsing keeps them in the
// AST as full `Keyword` nodes rather than opaque text. Magic prints
// the closing period of the second quoted keyword INSIDE its quotes
// (e.g. `gains "enchant ... with this Aura."`), so this effect ends
// at the second closing quote — no period is emitted afterwards.
loses_and_gains_keyword = {
    ^"it" ~ ^"loses" ~ quoted_keyword
  ~ ^"and" ~ ^"gains" ~ quoted_keyword_with_inner_period
}
quoted_keyword                   = _{ "\"" ~ keyword ~ "\"" }
quoted_keyword_with_inner_period = _{ "\"" ~ keyword ~ "." ~ "\"" }
source_gains_static_ability      = { source_object ~ ^"gains" ~ quoted_static_ability }
quoted_static_ability            = _{ "\"" ~ static_enchanted_loses_keyword ~ "\"" }
quoted_triggered_ability         = _{ "\"" ~ triggered_ability ~ "\"" }

// "Return enchanted <type> card to the battlefield under your control
// and attach this Aura to it."
return_enchanted_card_and_attach = {
    ^"return" ~ ^"enchanted" ~ permanent_type ~ ^"card"
  ~ ^"to" ~ ^"the" ~ ^"battlefield" ~ ^"under" ~ ^"your" ~ ^"control"
  ~ ^"and" ~ ^"attach" ~ ^"this" ~ ^"aura" ~ ^"to" ~ ^"it" ~ "."
}

// Silent: the indefinite article ("a" / "an") is recoverable from
// the following noun's initial sound at unparse time, so we don't
// store it in the AST. "an" is listed first because PEG alternatives
// are ordered and "a" is a prefix of "an".
article = _{ ^"an" | ^"a" }
