// Walking-skeleton grammar. Covers:
//   - Scryfall-style mana costs, e.g. `{2}{R}{R}`
//   - "Destroy target creature." / "Destroy all <permanent type>s."
//   - "Target player draws N cards." (N as an English word or variable)
//   - Keyword abilities (`Flying`, parameterized `Enchant <type>`, ...)
//   - Cards with multiple abilities separated by newlines
//   - Static abilities of the form
//       "As long as <cond>, <effect>."
//     where <effect> is a type-changing continuous effect on the
//     enchanted permanent (the Animate Artifact shape).
//
// Whitespace within an ability is implicit between tokens in
// non-atomic rules. `WHITESPACE` is just " " so newlines are never
// consumed implicitly — they act as ability separators at the top
// level.

WHITESPACE = _{ " " }

card_text = { SOI ~ (modal_choice | abilities) ~ EOI }

// Card text is a list of printed lines (paragraphs) separated by '\n'.
// Each line is either a single "phrase" ability (no terminating period,
// e.g. `Flying`, `Enchant creature`) or a chain of one or more
// "sentence" abilities (each ending in a period, e.g. two triggered
// abilities printed in a single line as on Animate Dead).
abilities = _{ line ~ ("\n" ~ line)* }
line      = _{ sentence_chain | phrase_statement }

// `+` plus implicit whitespace handles same-line chaining (Animate
// Dead's two triggers on one printed line, e.g.
// `... to it. When this Aura leaves ...`). Phrase statements like
// `Flying` or `{R}` aren't in this chain, which is what stops
// `parse("{2} {R}")` from silently accepting two mana costs.
sentence_chain     = _{ sentence_statement+ }
sentence_statement = _{
    modal_mode
  | cast_restriction
  | this_spell_costs_mana_more_to_cast_for_each_target_beyond_the_first
  | ante_play_restriction
  | you_own_target_card_in_zone
  | exchange_that_card_with_top_card_of_your_library
  | return_target_card_from_your_zone_to_zone
  | copy_target_spell_except_copy_is_color
  | you_may_choose_new_targets_for_the_copy
  | imperative_action_sequence
  | tap_target_permanent_choice
  | counter_target_spell
  | as_additional_cost_to_cast_this_spell
  | destroy
  | exile
  | that_permanents_controller_may_attach_this_aura_to_permanent_of_their_choice
  | regenerate_target_creature
  | damage_event_statement
  | next_damage_event_effect
  | damage_prevention_effect
  | for_each_damage_prevented_by_removing_pt_counter
  | spend_only_color_mana_on_variable
  | if_you_pay_source_deals_damage
  | as_source_enters_you_lose_life_equal_to_your_life_total
  | you_gain_life_equal_damage
  | you_dont_lose_game_for_having_zero_or_less_life
  | if_you_would_gain_life_draw_that_many_cards_instead
  | static_life_total_floor_replacement
  | variable_cant_be_number
  | if_you_cant_you_lose_the_game
  | it_cant_be_regenerated
  | if_its_permanent_cant_be_regenerated_and_would_die_exile_instead_this_turn
  | tap_all_permanents_then_mana_loss
  | player_payment_failure
  | target_player_activates_mana_ability_of_each_permanent_they_control
  | control_player_effect
  | referenced_card_play_instruction
  | mana_ability_activation_limit
  | conditional_control_player_effect
  | then_that_player_loses_unspent_mana_and_you_add_mana_lost_this_way
  | target_player_gains_life
  | its_controller_gains_life
  | take_extra_turn_after_this_one
  | if_you_would_event_you_may_skip_that_instead
  | look_at_top_cards_of_target_players_library_then_put_them_back_in_any_order
  | you_may_have_that_player_shuffle
  | draw_cards
  | target_player_discards_cards_at_random
  | add_mana
  | if_you_flip_result_effect
  | if_you_cant_source_deals_damage_to_you
  | until_eot_you_may_pay_cost_at_timing
  // Shared "If you do," wrapper; the payload decides the concrete effect.
  | if_you_do_effect
  | if_you_do_until_your_next_turn_you_cant_be_attacked_except_by_creatures_with_keywords
  | if_you_do_cast_that_card_face_down_without_paying_mana_cost
  | if_face_down_spell_creature_would_assign_or_deal_damage_or_tap_turn_face_up_instead
  | if_this_ability_activated_at_least_times_this_turn_sacrifice_source_at_next_end_step
  | only_sources_owner_may_activate_this_ability
  | change_text_of_target_spell_or_permanent_replacing_basic_land_type
  | target_spell_or_permanent_becomes_color
  | target_permanent_until_eot
  | each_player_performs_action
  | remove_target_creature_defending_player_controls_from_combat
  | creatures_it_was_blocking_become_unblocked
  | you_may_have_it_block_attacking_creature
  | creatures_attack_this_turn_if_able
  | target_creature_defending_player_controls_can_block_any_number
  | it_blocks_each_attacking_creature_if_able
  | destroy_referenced_creature_at_beginning_of_next_end_step
  | ignore_this_effect_for_each_creature_player_didnt_control_continuously
  | this_turn_defending_players_make_random_blocking_piles
  | additional_blockers_may_be_put_into_additional_piles
  | assign_each_pile_to_attacking_creature_at_random
  | creatures_in_assigned_pile_block_if_able
  | then_for_each_attacking_creature_choose_label_blocking_restriction
  | as_source_enters_choose
  | activated_ability_with_activation_permission
  | activated_ability
  | static_as_long_as
  | static_mana_spending_permission
  | static_colored_spells_cost_mana_more_to_cast
  | static_activated_abilities_of_colored_permanents_cost_mana_more_to_activate
  | static_colored_permanents_get
  | static_other_creature_type_get_and_have_keyword
  | static_status_creatures_you_control_get
  | static_enchanted_gets
  | static_enchanted_gets_with_definitions
  | static_enchanted_has_triggered_ability
  | static_enchanted_has_keyword_and_cant_be_enchanted_by_other_auras
  | static_enchanted_has_keyword
  | static_enchanted_loses_keyword
  | static_enchanted_is_basic_land_type
  | static_enchanted_can_attack_as_though_it_had
  | static_enchanted_can_attack_as_though_it_didnt_have
  | static_enchanted_cant_be_blocked_except_by_creature_type
  | static_all_creatures_able_to_block_enchanted_do_so
  | static_you_control_enchanted
  | static_you_have_no_maximum_hand_size
  | you_dont_lose_game_for_having_zero_or_less_life
  | if_you_would_gain_life_draw_that_many_cards_instead
  | static_life_total_floor_replacement
  | static_if_effect_causes_you_to_discard_card_you_may_put_it_on_top_of_library_instead
  | static_you_may_play_any_number_of_permanents_on_each_of_your_turns
  | static_play_restriction
  | static_you_may_have_source_enter_as_copy
  | static_source_enters_tapped
  | static_source_attacks_each_combat_if_able
  | static_source_cant_attack_unless_defending_player_controls_basic_land
  | static_source_cant_be_blocked_by_creature_type
  | static_source_doesnt_untap_during_your_untap_step
  | static_creatures_with_power_or_greater_dont_untap_during_their_controllers_untap_steps
  | static_source_cant_block_creatures_with_power_or_greater
  | static_named_source_pt_equal_to_count
  | static_effect_doesnt_remove_this_aura
  | static_basic_lands_are_pt_colored_creatures_still_lands
  | static_basic_lands_are_basic_lands
  | static_that_permanent_is_basic_land_type_while_has_named_counter
  | triggered_ability_fragment
  | triggered_ability
  | physical_action
  | each_player_equalizes_controlled_permanents
  | players_do_actions_the_same_way
  | source_enters_with_pt_counters
  | this_ability_cant_cause_total_pt_counters_greater_than
  | activate_only_during_your_upkeep
  | activate_only_during_combat
  | activate_only_during_your_turn_and_only_once_each_turn
  | activate_only_during_your_turn
  | activate_only_during_opponents_turn_before_attackers_declared
  | activate_only_as_sorcery
}

phrase_statement = _{
    modal_choice
  | mana_cost
  | label_phrase
  | semicolon_keyword_ability_list
  | keyword_ability_list
  | keyword_ability
  | triggered_ability_fragment
  | static_enchanted_loses_keyword_fragment
}

// Modal spells print a choice header followed by bullet-pointed modes.
// The header alone and each bullet alone are accepted for generated
// pattern tests, but the canonical full-card AST is one modal choice.
modal_choice = { choose_one ~ ("\n" ~ modal_mode)* }
choose_one    = { ^"choose" ~ ^"one" ~ "—" }
modal_mode    = { "•" ~ modal_effect }
modal_effect  = _{
    colored_target_effect
  | target_player_gains_life
  | damage_prevention_effect_this_turn
}
colored_target_effect = { colored_target_action ~ "." }
colored_target_action = _{
    counter_target_colored_spell_action
  | destroy_target_colored_permanent_action
}
counter_target_colored_spell = { counter_target_colored_spell_action ~ "." }
counter_target_colored_spell_action = {
    ^"counter" ~ ^"target" ~ color_word ~ ^"spell"
}
destroy_target_colored_permanent_action = {
    ^"destroy" ~ target_colored_permanent
}

mana_cost   = ${ mana_symbol+ }
mana_symbol = ${ "{" ~ mana_body ~ "}" }
mana_body   = _{ generic | color | variable_name }
generic     = @{ ASCII_DIGIT+ }
color       = @{ "W" | "U" | "B" | "R" | "G" | "C" }
tap_symbol  = ${ "{" ~ "T" ~ "}" }

this_spell_costs_mana_more_to_cast_for_each_target_beyond_the_first = {
    ^"this" ~ ^"spell" ~ ^"costs" ~ mana_cost ~ ^"more" ~ ^"to"
  ~ ^"cast" ~ ^"for" ~ ^"each" ~ ^"target" ~ ^"beyond" ~ ^"the"
  ~ ^"first" ~ "."
}

destroy = { ^"destroy" ~ destroy_target ~ "." }
exile = { ^"exile" ~ destroy_target ~ "." }
destroy_target = {
    all_creatures_blocking_or_blocked_by_it
  | destroy_all
  | target_basic_lands_count
  | target_colored_permanent
  | target_status_creature
  | target_qualified_creature
  | target_creature_type
  | target_permanent_choice
}
destroy_all = { ^"all" ~ destroy_all_objects }
destroy_all_objects = { basic_land_type_plural | permanent_type_plural_list }
all_creatures_blocking_or_blocked_by_it = {
    ^"all" ~ ^"creatures" ~ ^"blocking" ~ ^"or" ~ ^"blocked" ~ ^"by" ~ ^"it"
}
target_basic_lands_count = { card_count ~ ^"target" ~ basic_land_type_plural }
permanent_type_plural_list = {
    permanent_type_plural ~ (("," ~ permanent_type_plural)* ~ ","? ~ ^"and" ~ permanent_type_plural)?
}
counter_target_spell = {
    ^"counter" ~ ^"target" ~ color_word? ~ ^"spell" ~ counter_unless_cost? ~ "."
}
counter_unless_cost = {
    ^"unless" ~ ^"its" ~ ^"controller" ~ ^"pays" ~ mana_cost
  | ^"with" ~ ^"mana" ~ ^"value" ~ variable_name
}
regenerate_target_creature = { ^"regenerate" ~ ^"target" ~ ^"creature" ~ "." }
it_cant_be_regenerated = { (^"it" | ^"they") ~ ^"can't" ~ ^"be" ~ ^"regenerated" ~ "." }

copy_target_spell_except_copy_is_color = {
    ^"copy" ~ ^"target" ~ spell_type_choice ~ ^"spell" ~ ","
  ~ ^"except" ~ ^"that" ~ ^"the" ~ ^"copy" ~ ^"is" ~ color_word ~ "."
}
you_may_choose_new_targets_for_the_copy = {
    ^"you" ~ ^"may" ~ ^"choose" ~ ^"new" ~ ^"targets"
  ~ ^"for" ~ ^"the" ~ ^"copy" ~ "."
}
spell_type_choice = { spell_type ~ (^"or" ~ spell_type)* }
spell_type = @{ ^"instant" | ^"sorcery" }

damage_event_statement = {
    proper_name ~ ^"deals"
  ~ (
      damage_event_assignment_list
    | (damage_event_amount ~ ^"damage" ~ damage_event_recipients)
    | (^"damage" ~ damage_event_recipients ~ ^"equal" ~ ^"to" ~ ^"the" ~ damage_event_amount)
    )
  ~ "."
}
damage_event_amount = { damage_event_equal_to_amount | damage_amount_expression }
damage_event_equal_to_amount = {
    ^"number" ~ ^"of" ~ basic_land_type_plural ~ ^"put" ~ ^"into"
  ~ article ~ ^"graveyard" ~ ^"this" ~ ^"way"
}
damage_event_recipients = {
    damage_event_any_target
  | damage_event_divided_evenly_rounded_down_among_any_number_of_targets
  | damage_event_recipient_list
}
damage_event_assignment_list = {
    damage_event_assignment ~ (^"and" ~ damage_event_assignment)+
}
damage_event_assignment = {
    damage_event_amount ~ ^"damage" ~ ^"to" ~ damage_event_assignment_recipient
}
damage_event_assignment_recipient = _{
    any_target_prevention_recipient
  | you_damage_recipient
  | damage_recipient
}
damage_event_any_target = { ^"to" ~ ^"any" ~ ^"target" }
damage_event_divided_evenly_rounded_down_among_any_number_of_targets = {
    ^"divided" ~ ^"evenly" ~ "," ~ ^"rounded" ~ ^"down" ~ ","
  ~ ^"among" ~ ^"any" ~ ^"number" ~ ^"of" ~ ^"targets"
}
damage_event_recipient_list = {
    ^"to" ~ damage_recipient ~ (^"and" ~ damage_recipient)*
}
damage_prevention_effect = {
    damage_prevention_effect_sentence
}
damage_prevention_effect_sentence = {
    damage_prevention_replacement_effect ~ damage_prevention_duration_fragment?
  ~ damage_prevention_variable_definition? ~ "."
}
damage_prevention_effect_this_turn = {
    damage_prevention_replacement_effect ~ damage_prevention_duration
}
// Comprehensive Rules 614/615 split: a prevention effect replaces a
// damage event; amount, kind, recipient, and duration are data axes.
// This replacement event is shared by sentence, modal, and activated
// prevention effects; only the recipient vocabulary varies by context.
damage_prevention_replacement_effect = _{
    damage_prevention_replacement_event ~ damage_prevention_recipient_clause?
}
damage_prevention_replacement_event = _{
    ^"prevent" ~ (
      damage_prevention_amount_axis ~ damage_prevention_event
    | damage_prevention_of_that_damage
    )
}
damage_prevention_amount_axis = {
    damage_prevention_all_amount
  | damage_prevention_next_amount
  | damage_prevention_of_amount
}
damage_prevention_all_amount = { ^"all" }
damage_prevention_next_amount = { ^"the" ~ ^"next" ~ damage_prevention_amount }
damage_prevention_of_amount = { damage_prevention_amount ~ ^"of" }
damage_prevention_event = {
    damage_prevention_that_would_be_dealt
  | damage_prevention_of_that_damage
}
damage_prevention_that_would_be_dealt = {
    damage_kind? ~ ^"damage" ~ ^"that" ~ ^"would" ~ ^"be" ~ ^"dealt"
}
damage_prevention_of_that_damage = { ^"that" ~ ^"damage" }
damage_prevention_recipient_clause = { ^"to" ~ prevention_recipient }
damage_prevention_duration = _{ this_turn_period }
damage_prevention_duration_fragment = { ^"this" ~ ^"turn" }
this_turn_period = _{ ^"this" ~ ^"turn" ~ "." }
damage_prevention_variable_definition = { "," ~ where_clause }
damage_prevention_amount = _{ damage_amount_expression }
prevention_recipient = _{ any_target_prevention_recipient | that_permanent_or_player_prevention_recipient }
any_target_prevention_recipient = { ^"any" ~ ^"target" }
that_permanent_or_player_prevention_recipient = { ^"that" ~ ^"permanent" ~ ^"or" ~ ^"player" }
damage_recipient = {
    target_creature_you_control_damage_recipient
  | each_creature_with_keyword
  | each_creature_without_keyword
  | each_creature_damage_recipient
  | each_player_damage_recipient
  | that_player_damage_recipient
}
target_creature_you_control_damage_recipient = { ^"target" ~ ^"creature" ~ ^"you" ~ ^"control" }
each_creature_damage_recipient = { ^"each" ~ ^"creature" }
each_creature_with_keyword = { ^"each" ~ ^"creature" ~ ^"with" ~ keyword }
each_creature_without_keyword = { ^"each" ~ ^"creature" ~ ^"without" ~ keyword }
each_player_damage_recipient = { ^"each" ~ ^"player" }
proper_name = @{
    upper_alpha ~ (ASCII_ALPHANUMERIC | "'" | "-")*
  ~ (WHITESPACE ~ ((^"a" | ^"an" | ^"and" | ^"at" | ^"by" | ^"for" | ^"from" | ^"in" | ^"of" | ^"or" | ^"the" | ^"to" | ^"with") ~ WHITESPACE)? ~ upper_alpha ~ (ASCII_ALPHANUMERIC | "'" | "-")*)*
}
upper_alpha = _{ 'A'..'Z' }

spend_only_color_mana_on_variable = {
    ^"spend" ~ ^"only" ~ color_word ~ ^"mana" ~ ^"on" ~ variable_name ~ "."
}

as_source_enters_you_lose_life_equal_to_your_life_total = {
    ^"as" ~ source_object ~ ^"enters" ~ "," ~ ^"you" ~ ^"lose"
  ~ ^"life" ~ ^"equal" ~ ^"to" ~ ^"your" ~ ^"life" ~ ^"total" ~ "."
}

you_dont_lose_game_for_having_zero_or_less_life = {
    ^"you" ~ ^"don't" ~ ^"lose" ~ ^"the" ~ ^"game" ~ ^"for"
  ~ ^"having" ~ ^"0" ~ ^"or" ~ ^"less" ~ ^"life" ~ "."
}

life_gain_replacement_effect = {
    ^"if" ~ life_gain_replacement_affected_player ~ ^"would"
  ~ life_gain_replacement_replaced_event ~ ","
  ~ life_gain_replacement_result ~ ^"instead" ~ "."
}
life_gain_replacement_affected_player = { ^"you" }
life_gain_replacement_replaced_event = { ^"gain" ~ ^"life" }
life_gain_replacement_result = { draw_that_many_cards_replacement_result }
draw_that_many_cards_replacement_result = {
    ^"draw" ~ ^"that" ~ ^"many" ~ ^"cards"
}
if_you_would_gain_life_draw_that_many_cards_instead = { life_gain_replacement_effect }

static_life_total_floor_replacement = {
    life_total_floor_cause ~ ^"that" ~ ^"would" ~ ^"reduce" ~ life_total_floor_player
  ~ ^"life" ~ ^"total" ~ ^"to" ~ ^"less" ~ ^"than" ~ unsigned_number
  ~ ^"reduces" ~ ^"it" ~ ^"to" ~ unsigned_number ~ ^"instead" ~ "."
}
life_total_floor_cause = { ^"damage" }
life_total_floor_player = { ^"your" }

variable_cant_be_number = {
    variable_name ~ ^"can't" ~ ^"be" ~ unsigned_number ~ "."
}

if_you_cant_you_lose_the_game = {
    ^"if" ~ ^"you" ~ ^"can't" ~ "," ~ ^"you" ~ ^"lose"
  ~ ^"the" ~ ^"game" ~ "."
}

you_gain_life_equal_damage = {
    you_gain_life_equal_damage_dealt_capped
  | you_gain_life_equal_damage_prevented_this_way
  | you_gain_life_equal_damage_dealt_to_you_this_turn
}
you_gain_life_equal_damage_dealt_capped = {
    ^"you" ~ ^"gain" ~ ^"life" ~ ^"equal" ~ ^"to" ~ ^"the"
  ~ ^"damage" ~ ^"dealt" ~ "," ~ ^"but" ~ ^"not" ~ ^"more"
  ~ ^"life" ~ ^"than" ~ damage_life_gain_cap
  ~ ("," ~ damage_life_gain_cap)* ~ ","? ~ ^"or" ~ damage_life_gain_cap ~ "."
}
you_gain_life_equal_damage_prevented_this_way = {
    ^"you" ~ ^"gain" ~ ^"life" ~ ^"equal" ~ ^"to" ~ ^"the"
  ~ ^"damage" ~ ^"prevented" ~ ^"this" ~ ^"way" ~ "."
}
you_gain_life_equal_damage_dealt_to_you_this_turn = {
    ^"you" ~ ^"gain" ~ ^"life" ~ ^"equal" ~ ^"to" ~ ^"the"
  ~ damage_dealt_to_you_this_turn ~ "."
}

damage_life_gain_cap = _{
    player_life_total_before_damage_dealt
  | planeswalker_loyalty_before_damage_dealt
  | creature_toughness
}
player_life_total_before_damage_dealt = {
    ^"the" ~ ^"player's" ~ ^"life" ~ ^"total" ~ ^"before"
  ~ ^"the" ~ ^"damage" ~ ^"was" ~ ^"dealt"
}
planeswalker_loyalty_before_damage_dealt = {
    ^"the" ~ ^"planeswalker's" ~ ^"loyalty" ~ ^"before"
  ~ ^"the" ~ ^"damage" ~ ^"was" ~ ^"dealt"
}
creature_toughness = { ^"the" ~ ^"creature's" ~ ^"toughness" }

if_its_permanent_cant_be_regenerated_and_would_die_exile_instead_this_turn = {
    ^"if" ~ ^"it's" ~ article ~ permanent_type ~ "," ~ ^"it" ~ ^"can't"
  ~ ^"be" ~ ^"regenerated" ~ ^"this" ~ ^"turn" ~ "," ~ ^"and"
  ~ ^"if" ~ ^"it" ~ ^"would" ~ ^"die" ~ ^"this" ~ ^"turn" ~ ","
  ~ ^"exile" ~ ^"it" ~ ^"instead" ~ "."
}

draw_cards  = { ^"target" ~ ^"player" ~ ^"draws" ~ draw_count ~ ^"cards" ~ "." }
draw_count  = _{ card_count }
card_count  = _{ number_word | variable_name }
number_word = @{
    ^"one" | ^"two" | ^"three" | ^"four" | ^"five"
  | ^"six" | ^"seven" | ^"eight" | ^"nine" | ^"ten"
}
target_player_discards_cards_at_random = {
  target_player_discard_prefix ~ discard_amount ~ discard_at_random ~ "."
}
player_discards_cards = {
  player_discard_prefix ~ discard_amount ~ discard_randomness? ~ "."
}
player_discard_prefix = _{
    target_player_discard_prefix
  | that_player_discard_prefix
  | each_player_discard_prefix
  | you_discard_prefix
}
target_player_discard_prefix = _{ target_player_discard_actor ~ ^"discards" }
that_player_discard_prefix = _{ that_player_discard_actor ~ ^"discards" }
each_player_discard_prefix = _{ each_player_discard_actor ~ ^"discards" }
you_discard_prefix = _{ you_discard_actor ~ ^"discard" }
target_player_discard_actor = _{ ^"target" ~ ^"player" }
that_player_discard_actor = _{ ^"that" ~ ^"player" }
each_player_discard_actor = _{ ^"each" ~ ^"player" }
you_discard_actor = _{ ^"you" }
discard_amount = _{ discard_one_card | discard_counted_cards }
discard_randomness = _{ discard_at_random }
discard_at_random = _{ ^"at" ~ ^"random" }
if_you_would_event_you_may_skip_that_instead = {
    if_you_would_skip_event ~ ","
  ~ (skip_event_instead_prefix | skip_event_instead_suffix)
  ~ "."
}
if_you_would_skip_event = _{
    draw_card_during_your_draw_step
  | begin_your_turn_while_source_is_status
}
draw_card_during_your_draw_step = {
    ^"if" ~ ^"you" ~ ^"would" ~ ^"draw" ~ article ~ ^"card"
  ~ ^"during" ~ ^"your" ~ ^"draw" ~ ^"step"
}
begin_your_turn_while_source_is_status = {
    ^"if" ~ ^"you" ~ ^"would" ~ ^"begin" ~ ^"your" ~ ^"turn"
  ~ ^"while" ~ source_object ~ ^"is" ~ object_status
}
skip_event_instead_prefix = {
    ^"instead" ~ ^"you" ~ ^"may" ~ ^"skip" ~ ^"that" ~ skip_event_reference
}
skip_event_instead_suffix = {
    ^"you" ~ ^"may" ~ ^"skip" ~ ^"that" ~ skip_event_reference ~ ^"instead"
}
skip_event_reference = _{ ^"draw" | ^"turn" }
player_gains_life = {
    player_gains_life_recipient ~ player_gains_life_predicate ~ "."
}
target_player_gains_life = {
    target_player_life_gain_recipient ~ player_gains_life_predicate ~ "."
}
its_controller_gains_life = {
    its_controller_life_gain_recipient ~ player_gains_life_predicate ~ "."
}
life_gain_fixed_amount_statement = {
    player_gains_life_recipient ~ ^"gains" ~ life_gain_fixed_amount ~ "."
}
player_gains_life_recipient = _{
    target_player_life_gain_recipient
  | its_controller_life_gain_recipient
}
target_player_life_gain_recipient = _{ ^"target" ~ ^"player" }
its_controller_life_gain_recipient = _{ ^"its" ~ ^"controller" }
player_gains_life_predicate = _{ ^"gains" ~ life_gain_amount }
life_gain_amount = {
    life_gain_fixed_amount
  | life_gain_equal_to_its_power
}
life_gain_fixed_amount = { (unsigned_number | variable_name) ~ ^"life" }
life_gain_equal_to_its_power = {
    ^"life" ~ ^"equal" ~ ^"to" ~ ^"its" ~ ^"power"
}

look_at_top_cards_of_target_players_library_then_put_them_back_in_any_order = {
    ^"look" ~ ^"at" ~ ^"the" ~ ^"top" ~ draw_count ~ ^"cards"
  ~ ^"of" ~ ^"target" ~ ^"player's" ~ ^"library" ~ ","
  ~ ^"then" ~ ^"put" ~ ^"them" ~ ^"back" ~ ^"in" ~ ^"any" ~ ^"order" ~ "."
}

you_may_have_that_player_shuffle = {
    ^"you" ~ ^"may" ~ ^"have" ~ ^"that" ~ ^"player" ~ ^"shuffle" ~ "."
}

tap_all_permanents_then_mana_loss = {
    ^"tap" ~ tap_all_controlled_permanents_scope ~ ^"target" ~ ^"player"
  ~ ^"controls" ~ ^"and" ~ that_player_loses_all_unspent_mana ~ "."
}

player_payment_failure = {
    ^"if" ~ ^"that" ~ ^"player" ~ ^"doesn't" ~ ","
  ~ payment_failure_effect ~ "."
}
payment_failure_effect = _{ payment_failure_tap_mana_sources }
payment_failure_tap_mana_sources = {
    ^"they" ~ ^"tap" ~ tap_all_controlled_permanents_scope_with_optional_mana_abilities
  ~ ^"they" ~ ^"control" ~ ^"and" ~ lose_all_unspent_mana
}
tap_all_controlled_permanents_scope = _{ ^"all" ~ permanent_type_plural }
tap_all_controlled_permanents_scope_with_optional_mana_abilities = _{
    tap_all_controlled_permanents_scope ~ with_mana_abilities?
}
that_player_loses_all_unspent_mana = _{
    ^"that" ~ ^"player" ~ ^"loses" ~ ^"all" ~ ^"unspent" ~ ^"mana"
}
lose_all_unspent_mana = _{ ^"lose" ~ ^"all" ~ ^"unspent" ~ ^"mana" }
with_mana_abilities = { ^"with" ~ ^"mana" ~ ^"abilities" }

target_player_activates_mana_ability_of_each_permanent_they_control = {
    ^"target" ~ ^"player" ~ ^"activates" ~ article ~ ^"mana" ~ ^"ability"
  ~ ^"of" ~ ^"each" ~ permanent_type ~ ^"they" ~ ^"control" ~ "."
}

control_player_effect = {
    controller_ref ~ ^"control" ~ controlled_player_ref ~ control_duration ~ "."
}
controller_ref = { ^"you" }
controlled_player_ref = { ^"that" ~ ^"player" | ^"the" ~ ^"player" }
control_duration = {
    ^"until" ~ source_resolution_duration
  | ^"while" ~ spell_resolution_duration
}
source_resolution_duration = { proper_name ~ ^"finishes" ~ ^"resolving" }
spell_resolution_duration = { ^"that" ~ ^"spell" ~ ^"is" ~ ^"resolving" }

referenced_card_play_instruction = {
    controlled_player_ref ~ ^"plays" ~ referenced_card_ref ~ if_able_clause? ~ "."
}
referenced_card_ref = { ^"that" ~ ^"card" }
if_able_clause = { ^"if" ~ ^"able" }

mana_ability_activation_limit = {
    activation_limit_context ~ "," ~ controlled_player_ref ~ ^"can"
  ~ ^"activate" ~ ^"mana" ~ ^"abilities" ~ ^"only" ~ ^"if"
  ~ mana_ability_source_limit ~ ^"and" ~ ^"only" ~ ^"if"
  ~ produced_mana_spending_limit ~ "."
}
activation_limit_context = { ^"while" ~ ^"doing" ~ ^"so" }
mana_ability_source_limit = {
    ^"they're" ~ ^"from" ~ ^"lands" ~ ^"that" ~ ^"player" ~ ^"controls"
}
produced_mana_spending_limit = {
    ^"mana" ~ ^"they" ~ ^"produce" ~ ^"is" ~ ^"spent" ~ ^"to"
  ~ mana_spending_purpose ~ (^"and/or" ~ ^"to" ~ mana_spending_purpose)*
}
mana_spending_purpose = {
    ^"activate" ~ ^"other" ~ ^"mana" ~ ^"abilities" ~ ^"of" ~ ^"lands"
  ~ ^"the" ~ ^"player" ~ ^"controls"
  | ^"play" ~ referenced_card_ref
}

conditional_control_player_effect = {
    ^"if" ~ control_player_condition ~ "," ~ control_player_effect
}
control_player_condition = {
    ^"the" ~ ^"chosen" ~ ^"card" ~ ^"is" ~ ^"cast" ~ ^"as" ~ article ~ ^"spell"
}

then_that_player_loses_unspent_mana_and_you_add_mana_lost_this_way = {
    ^"then" ~ ^"that" ~ ^"player" ~ ^"loses" ~ ^"all" ~ ^"unspent"
  ~ ^"mana" ~ ^"and" ~ ^"you" ~ ^"add" ~ ^"the" ~ ^"mana"
  ~ ^"lost" ~ ^"this" ~ ^"way" ~ "."
}

ante_play_restriction = {
    ^"remove" ~ ^"this" ~ ^"card" ~ ^"from" ~ ^"your" ~ ^"deck"
  ~ ^"before" ~ ^"playing" ~ ^"if" ~ ^"you're" ~ ^"not"
  ~ ^"playing" ~ ^"for" ~ ^"ante" ~ "."
}

you_own_target_card_in_zone = {
    ^"you" ~ ^"own" ~ ^"target" ~ ^"card" ~ ^"in" ~ ^"the" ~ zone ~ "."
}

return_target_card_from_your_zone_to_zone = {
    ^"return" ~ ^"target" ~ return_target_card_kind
  ~ (^"from" ~ ^"your" ~ owned_zone)?
  ~ ^"to" ~ return_destination_zone ~ "."
}

return_target_card_kind = { (permanent_type ~ ^"card") | ^"card" | permanent_type }
return_destination_zone = { (^"your" ~ owned_zone) | (^"the" ~ battlefield_zone) | (^"its" ~ ^"owner's" ~ owned_zone) }
battlefield_zone = @{ ^"battlefield" }

exchange_that_card_with_top_card_of_your_library = {
    ^"exchange" ~ ^"that" ~ ^"card" ~ ^"with" ~ ^"the" ~ ^"top"
  ~ ^"card" ~ ^"of" ~ ^"your" ~ ^"library" ~ "."
}

imperative_action_sequence = {
    (
      (look_at_target_hand_action ~ ^"and" ~ choose_card_from_it_action)
    | (imperative_action ~ ("," ~ imperative_action)* ~ "," ~ ^"then" ~ imperative_action)
    )
  ~ "."
}

imperative_action = _{
    look_at_target_hand_action
  | choose_card_from_it_action
  | discard_your_hand_action
  | ante_top_card_of_your_library_action
  | search_your_library_for_a_card_action
  | put_that_card_into_your_hand_action
  | shuffle_action
  | draw_cards_action
  | tap_source_action
  | sacrifice_permanent_of_opponents_choice_action
}
look_at_target_hand_action = {
    ^"look" ~ ^"at" ~ target_hand_player ~ ^"hand"
}
target_hand_player = { ^"target player's" | ^"target opponent's" }
choose_card_from_it_action = { ^"choose" ~ article ~ ^"card" ~ ^"from" ~ ^"it" }
discard_your_hand_action = { ^"discard" ~ (^"your" ~ ^"hand" | discard_counted_cards) }
ante_top_card_of_your_library_action = {
    ^"ante" ~ ^"the" ~ ^"top" ~ ^"card" ~ ^"of" ~ ^"your" ~ ^"library"
}
search_your_library_for_a_card_action = {
    ^"search" ~ ^"your" ~ ^"library" ~ ^"for" ~ article ~ ^"card"
}
put_that_card_into_your_hand_action = {
    ^"put" ~ ^"that" ~ ^"card" ~ ^"into" ~ ^"your" ~ ^"hand"
}
shuffle_action = { ^"shuffle" }
draw_cards_action = { draw_verb ~ draw_count ~ ^"cards" }
draw_verb = _{ ^"draws" | ^"draw" }
tap_source_action = { ^"tap" ~ source_object }
sacrifice_permanent_of_opponents_choice_action = {
    ^"sacrifice" ~ article ~ permanent_type ~ ^"of" ~ article ~ ^"opponent's" ~ ^"choice"
}

each_player_performs_action = {
    ^"each" ~ ^"player" ~ each_player_action_sequence ~ "."
}
each_player_action_sequence = {
    each_player_action
  ~ (("," ~ each_player_action)* ~ ","? ~ ^"then" ~ each_player_action)?
}
each_player_action = _{
    each_player_antes_top_card_of_their_library_action
  | each_player_shuffles_their_hand_and_graveyard_into_their_library_action
  | each_player_discards_their_hand_action
  | draw_cards_action
}
each_player_antes_top_card_of_their_library_action = {
    ^"antes" ~ ^"the" ~ ^"top" ~ ^"card" ~ ^"of" ~ ^"their" ~ ^"library"
}
each_player_shuffles_their_hand_and_graveyard_into_their_library_action = {
    ^"shuffles" ~ ^"their" ~ ^"hand" ~ ^"and" ~ ^"graveyard"
  ~ ^"into" ~ ^"their" ~ ^"library"
}
each_player_discards_their_hand_action = {
    ^"discards" ~ ^"their" ~ ^"hand"
}

until_eot_you_may_pay_cost_at_timing = {
    ^"until" ~ ^"end" ~ ^"of" ~ ^"turn" ~ ","
  ~ ((action_timing ~ "," ~ ^"you" ~ ^"may" ~ optional_cost)
    | (^"you" ~ ^"may" ~ optional_cost ~ action_timing))
  ~ "."
}

action_timing = _{ any_time_you_could_activate_a_mana_ability | any_time_you_could_cast_an_instant }
any_time_you_could_activate_a_mana_ability = {
    ^"any" ~ ^"time" ~ ^"you" ~ ^"could" ~ ^"activate" ~ article
  ~ ^"mana" ~ ^"ability"
}
any_time_you_could_cast_an_instant = {
    ^"any" ~ ^"time" ~ ^"you" ~ ^"could" ~ ^"cast" ~ article ~ ^"instant"
}

optional_cost = _{ pay_life_cost | pay_mana_cost }
pay_life_cost = { ^"pay" ~ unsigned_number ~ ^"life" }
pay_mana_cost = { ^"pay" ~ mana_cost }

if_you_do_effect = { if_do_actor ~ if_you_do_effect_body }
if_do_actor = _{ (^"if" ~ ^"you" ~ ^"do" ~ ",") | (^"if" ~ ^"the" ~ ^"player" ~ ^"does" ~ ",") }
if_you_do_effect_body = _{
    add_mana
  | untap_source
  | untap_referenced_permanent
  | gain_life_effect
  | damage_prevention_effect_this_turn
}
if_you_do_gain_life = { ^"if" ~ ^"you" ~ ^"do" ~ "," ~ gain_life_effect }
gain_life_effect = { ^"you" ~ ^"gain" ~ unsigned_number ~ ^"life" ~ "." }
if_you_do_until_your_next_turn_you_cant_be_attacked_except_by_creatures_with_keywords = {
    ^"if" ~ ^"you" ~ ^"do" ~ "," ~ ^"until" ~ ^"your" ~ ^"next"
  ~ ^"turn" ~ "," ~ ^"you" ~ ^"can't" ~ ^"be" ~ ^"attacked"
  ~ ^"except" ~ ^"by" ~ ^"creatures" ~ ^"with" ~ keyword_and_or_list ~ "."
}
keyword_and_or_list = { keyword ~ (^"and/or" ~ keyword)* }

// Balance-style resource equalization:
// each player keeps a count of objects matching the least-stocked player,
// then follow-up actions can apply "the same way" to other resources.
each_player_equalizes_controlled_permanents = {
    ^"each" ~ ^"player" ~ ^"chooses" ~ article ~ ^"number" ~ ^"of"
  ~ permanent_type_plural ~ ^"they" ~ ^"control" ~ ^"equal" ~ ^"to"
  ~ ^"the" ~ ^"number" ~ ^"of" ~ permanent_type_plural ~ ^"controlled"
  ~ ^"by" ~ ^"the" ~ ^"player" ~ ^"who" ~ ^"controls" ~ ^"the"
  ~ ^"fewest" ~ "," ~ ^"then" ~ ^"sacrifices" ~ ^"the" ~ ^"rest" ~ "."
}

players_do_actions_the_same_way = {
    ^"players" ~ balance_same_way_action
  ~ (^"and" ~ balance_same_way_action)*
  ~ ^"the" ~ ^"same" ~ ^"way" ~ "."
}

as_source_enters_choose = {
    ^"as" ~ source_object ~ ^"enters" ~ "," ~ ^"choose" ~ as_enters_choice ~ "."
}
as_enters_choice = _{ opponent_choice | basic_land_type_choice | article ~ ^"color" }
opponent_choice = { article ~ ^"opponent" }
basic_land_type_choice = { article ~ ^"basic" ~ ^"land" ~ ^"type" }

balance_same_way_action = _{ discard_cards_action | sacrifice_permanents_action }
discard_cards_action = { ^"discard" ~ ^"cards" }
sacrifice_permanents_action = { ^"sacrifice" ~ permanent_type_plural }

keyword_ability = { keyword }
keyword_ability_list = { keyword ~ ("," ~ keyword)+ }
semicolon_keyword_ability_list = { keyword ~ (";" ~ keyword)+ }
keyword              = _{ enchant | protection | landwalk | keyword_ability_name }
keyword_ability_name = @{ ^"first" ~ " " ~ ^"strike" | ^"flying" | ^"reach" | ^"haste" | ^"defender" | ^"banding" | ^"trample" | ^"indestructible" | ^"fear" | ^"vigilance" }
label_phrase = { label_word }
label_word = @{ ^"left" | ^"right" }
quoted_label = { "\"" ~ label_word ~ "\"" }
quoted_label_with_inner_period = { "\"" ~ label_word ~ "." ~ "\"" }
landwalk        = ${ basic_land_type ~ ^"walk" }
protection      = { ^"protection" ~ ^"from" ~ color_word }

cast_restriction = {
    ^"cast" ~ ^"this" ~ ^"spell" ~ ^"only" ~ cast_timing ~ "."
}
before_step = { ^"before" ~ ^"the" ~ step ~ ^"step" }
during_step = { ^"during" ~ ^"the" ~ step ~ ^"step" }
during_your_step = { ^"during" ~ ^"your" ~ step ~ ^"step" }
// Factor the shared `declare` prefix so declare-step names don't shadow
// each other under PEG's ordered matching.
step = { ^"combat" ~ ^"damage" | ^"declare" ~ (^"attackers" | ^"blockers") }
during_opponents_turn_before_attackers_declared = {
    ^"during" ~ article ~ ^"opponent's" ~ ^"turn" ~ "," ~ ^"before"
  ~ ^"attackers" ~ ^"are" ~ ^"declared"
}
cast_timing = _{ during_opponents_turn_before_attackers_declared | during_combat_before_blockers_declared | during_your_step | during_step | before_step }
during_combat_before_blockers_declared = {
    ^"during" ~ ^"combat" ~ ^"before" ~ ^"blockers" ~ ^"are" ~ ^"declared"
}

// `Enchant <object>`. Order the longer alternatives first so PEG's
// first-match doesn't stop at the bare permanent type.
enchant = {
    ^"enchant"
  ~ (enchant_put_onto_battlefield | enchant_card_in_zone | enchant_permanent | enchant_creature_type)
}
enchant_permanent    = { permanent_type }
enchant_creature_type = { creature_type }
enchant_card_in_zone = { permanent_type ~ ^"card" ~ ^"in" ~ article ~ zone }
enchant_put_onto_battlefield = {
    permanent_type ~ ^"put" ~ ^"onto" ~ ^"the" ~ ^"battlefield"
  ~ ^"with" ~ ^"this" ~ ^"aura"
}
zone = @{ ^"graveyard" | ^"ante" }
owned_zone = @{ ^"graveyard" | ^"hand" }

// Card types that appear as keyword arguments or in type lines.
// Atomic so each alternative is matched as a single word.
permanent_type = @{
    ^"artifact"
  | ^"creature"
  | ^"enchantment"
  | ^"land"
  | ^"planeswalker"
}

permanent_type_plural = @{
    ^"artifacts"
  | ^"creatures"
  | ^"enchantments"
  | ^"lands"
  | ^"planeswalkers"
}

color_word = @{
    ^"white"
  | ^"blue"
  | ^"black"
  | ^"red"
  | ^"green"
 }

// Creature subtypes that appear as Aura targets, enchanted objects, or
// creature-type selectors.
creature_type = @{ ^"djinn" | ^"goblin" | ^"golem" | ^"insect" | ^"merfolk" | ^"wall" | ^"zombie" }
creature_type_plural = @{ ^"djinns" | ^"goblins" | ^"golems" | ^"insects" | ^"merfolk" | ^"walls" | ^"zombies" }

// Static abilities. Five surface shapes today:
//   - "As long as <cond>, <effect>." — conditional continuous effect.
//   - "<Color> <type>s get <pt_modifier>." — P/T modifier on objects
//     matching a color and permanent type.
//   - "Other <creature_type>s get <pt_modifier> and have <ability>." /
//     "Other <creature_type> creatures have <ability>." — lord-style
//     ability grants, optionally with a P/T modifier, for other
//     creatures or objects of a subtype.
//   - "<Status> creatures [you control] get <pt_modifier> [until end of
//     turn]." — P/T modifier on creatures matching a combat/tapped state.
//   - "Enchanted <type> gets <pt_modifier>." — unconditional P/T
//     modifier on the enchanted permanent (e.g. Animate Dead).
//   - "Enchanted <type> gets <variable_pt_modifier>, where ..." — a
//     variable P/T modifier with printed definitions for those variables.
//   - "Enchanted <object> has <keyword>." — keyword-granting effect on
//     the enchanted object.
//   - "Enchanted <object> has <keyword> and can't be enchanted by other
//     Auras." — keyword-granting effect plus an Aura attachment
//     restriction on the enchanted object.
//   - "Enchanted <object> can attack as though it had/didn't have
//     <keyword>." — permission effect that changes attack eligibility.
//   - "Enchanted <object> can't be blocked except by <creature_type>s."
//     — evasion restriction with an allowed blocking subtype.
//   - "You control enchanted <object>." — continuous control-changing
//     effect from an Aura to its enchanted object.
//   - "You may have this <type> enter as a copy of any <type> on the
//     battlefield." — optional as-enters copy replacement effect.
//   - "This <type> attacks each combat if able." — attack requirement.
//   - "This <type> can't be blocked by <creature_type>s." — evasion
//     restriction against a blocking subtype.
//   - "This effect doesn't remove this Aura." — effect-continuity text
//     that preserves the Aura while applying the preceding static effect.
static_ability = _{
    static_as_long_as
  | static_mana_spending_permission
  | static_colored_spells_cost_mana_more_to_cast
  | static_activated_abilities_of_colored_permanents_cost_mana_more_to_activate
  | static_colored_permanents_get
  | static_other_creature_type_get_and_have_keyword
  | static_status_creatures_you_control_get
  | static_enchanted_gets
  | static_enchanted_gets_with_definitions
  | static_enchanted_has_triggered_ability
  | static_enchanted_has_keyword_and_cant_be_enchanted_by_other_auras
  | static_enchanted_has_keyword
  | static_enchanted_loses_keyword
  | static_enchanted_is_basic_land_type
  | static_enchanted_can_attack_as_though_it_had
  | static_enchanted_can_attack_as_though_it_didnt_have
  | static_enchanted_cant_be_blocked_except_by_creature_type
  | static_all_creatures_able_to_block_enchanted_do_so
  | static_you_control_enchanted
  | static_you_may_play_any_number_of_permanents_on_each_of_your_turns
  | you_dont_lose_game_for_having_zero_or_less_life
  | if_you_would_gain_life_draw_that_many_cards_instead
  | static_life_total_floor_replacement
  | static_play_restriction
  | static_you_may_have_source_enter_as_copy
  | static_source_enters_tapped
  | static_source_attacks_each_combat_if_able
  | static_source_cant_attack_unless_defending_player_controls_basic_land
  | static_source_cant_be_blocked_by_creature_type
  | static_creatures_with_power_or_greater_dont_untap_during_their_controllers_untap_steps
  | static_source_cant_block_creatures_with_power_or_greater
  | static_named_source_pt_equal_to_count
  | static_effect_doesnt_remove_this_aura
  | static_basic_lands_are_pt_colored_creatures_still_lands
  | static_basic_lands_are_basic_lands
  | static_that_permanent_is_basic_land_type_while_has_named_counter
}

static_as_long_as = {
    (^"as" ~ ^"long" ~ ^"as" ~ condition ~ "," ~ continuous_effect ~ ".")
  | (continuous_effect ~ ^"as" ~ ^"long" ~ ^"as" ~ condition ~ ".")
}

static_mana_spending_permission = {
    ^"you" ~ ^"may" ~ ^"spend" ~ color_word ~ ^"mana"
  ~ ^"as" ~ ^"though" ~ ^"it" ~ ^"were" ~ color_word ~ ^"mana" ~ "."
}

static_colored_spells_cost_mana_more_to_cast = {
    color_word ~ ^"spells" ~ ^"cost" ~ mana_cost ~ ^"more" ~ ^"to" ~ ^"cast" ~ "."
}

static_activated_abilities_of_colored_permanents_cost_mana_more_to_activate = {
    ^"activated" ~ ^"abilities" ~ ^"of" ~ color_word ~ permanent_type_plural
  ~ ^"cost" ~ mana_cost ~ ^"more" ~ ^"to" ~ ^"activate" ~ "."
}

static_colored_permanents_get = {
    color_word ~ permanent_type_plural ~ ^"get" ~ pt_modifier ~ "."
}

static_other_creature_type_get_and_have_keyword = {
    ^"other" ~ other_creature_type_subject
  ~ (
      (^"get" ~ pt_modifier ~ ^"and" ~ ^"have" ~ other_creature_type_granted_ability)
    | (^"have" ~ other_creature_type_granted_ability)
  )
}

other_creature_type_subject = {
    creature_type ~ ^"creatures"
  | creature_type_plural
}

other_creature_type_granted_ability = _{
    ("\"" ~ activated_ability ~ "\"")
  | (keyword ~ ".")
}

static_status_creatures_you_control_get = {
    creature_status ~ ^"creatures" ~ status_creature_controller?
  ~ ^"get" ~ pt_modifier ~ status_creature_get_duration? ~ "."
}

status_creature_controller = { ^"you" ~ ^"control" }
status_creature_get_duration = { ^"until" ~ ^"end" ~ ^"of" ~ ^"turn" }

creature_status = @{ ^"attacking" | ^"tapped" | ^"untapped" }

static_enchanted_gets = {
    ^"enchanted" ~ permanent_type ~ ^"gets" ~ pt_modifier
  ~ (^"and" ~ ^"has" ~ keyword)?
  ~ "."
}

static_enchanted_gets_with_definitions = {
    ^"enchanted" ~ permanent_type ~ ^"gets" ~ variable_pt_modifier
  ~ "," ~ where_clause ~ "."
}

static_enchanted_has_keyword = {
    ^"enchanted" ~ enchanted_object ~ ^"has" ~ keyword ~ "."
}

static_enchanted_has_triggered_ability = {
    ^"enchanted" ~ enchanted_object ~ ^"has" ~ quoted_triggered_ability
}

static_enchanted_loses_keyword = {
    ^"enchanted" ~ enchanted_object ~ ^"loses" ~ keyword ~ "."
}
static_enchanted_loses_keyword_fragment = {
    ^"enchanted" ~ enchanted_object ~ ^"loses" ~ keyword
}

static_enchanted_is_basic_land_type = {
    ^"enchanted" ~ enchanted_object ~ ^"is" ~ basic_land_type_reference ~ "."
}
basic_land_type_reference = _{ specific_basic_land_type | chosen_basic_land_type }
specific_basic_land_type = { article ~ basic_land_type }
