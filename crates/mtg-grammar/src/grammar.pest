  ~ ^"as" ~ ^"it" ~ ^"resolves" ~ ^"has" ~ ^"not" ~ ^"been"
  ~ ^"turned" ~ ^"face" ~ ^"up" ~ ^"and" ~ ^"would" ~ ^"assign"
  ~ ^"or" ~ ^"deal" ~ ^"damage" ~ "," ~ ^"be" ~ ^"dealt"
  ~ ^"damage" ~ "," ~ ^"or" ~ ^"become" ~ ^"tapped" ~ ","
  ~ ^"instead" ~ ^"it's" ~ ^"turned" ~ ^"face" ~ ^"up" ~ ^"and"
  ~ ^"assigns" ~ ^"or" ~ ^"deals" ~ ^"damage" ~ "," ~ ^"is"
  ~ ^"dealt" ~ ^"damage" ~ "," ~ ^"or" ~ ^"becomes" ~ ^"tapped" ~ "."
}

activate_only_during_your_upkeep = {
    ^"activate" ~ ^"only" ~ ^"during" ~ ^"your" ~ ^"upkeep" ~ "."
}
activate_only_during_combat = {
    ^"activate" ~ ^"only" ~ ^"during" ~ ^"combat" ~ "."
}
activate_only_during_your_turn_and_only_once_each_turn = {
    ^"activate" ~ ^"only" ~ ^"during" ~ ^"your" ~ ^"turn" ~ ^"and"
  ~ ^"only" ~ ^"once" ~ ^"each" ~ ^"turn" ~ "."
}
activate_only_during_your_turn = {
    ^"activate" ~ ^"only" ~ ^"during" ~ ^"your" ~ ^"turn" ~ "."
}
activate_only_during_opponents_turn_before_attackers_declared = {
    ^"activate" ~ ^"only" ~ ^"during" ~ article ~ ^"opponent's"
  ~ ^"turn" ~ "," ~ ^"before" ~ ^"attackers" ~ ^"are"
  ~ ^"declared" ~ "."
}
activate_only_as_sorcery = {
    ^"activate" ~ ^"only" ~ ^"as" ~ article ~ ^"sorcery" ~ "."
}

destroy_that_creature_if_it_attacked_this_turn = {
    ^"destroy" ~ that_creature_subject ~ ^"if" ~ ^"it"
  ~ ^"attacked" ~ ^"this" ~ ^"turn" ~ "."
}

destroy_it = { ^"destroy" ~ ^"it" ~ "." }

destroy_referenced_creature_at_beginning_of_next_end_step = {
    ^"destroy" ~ referenced_creature ~ ^"at" ~ beginning_of_the_next_end_step
  ~ destroy_referenced_creature_condition? ~ "."
}
referenced_creature = { ^"it" | ^"that" ~ ^"creature" }
destroy_referenced_creature_condition = {
    ^"if" ~ ^"it" ~ ^"didn't" ~ ^"attack" ~ ^"this" ~ ^"turn"
}

destroy_that_creature_at_end_of_combat = {
    ^"destroy" ~ that_creature_subject ~ ^"at" ~ end_of_combat ~ "."
}

that_creatures_controller_sacrifices_it = {
    ^"that" ~ ^"creature's" ~ ^"controller" ~ ^"sacrifices" ~ ^"it" ~ "."
}
their_controllers_sacrifice_them = {
    ^"their" ~ ^"controllers" ~ ^"sacrifice" ~ ^"them" ~ "."
}

sacrifice_permanent_other_than_source = {
    ^"sacrifice" ~ article ~ permanent_type ~ ^"other" ~ ^"than" ~ source_object ~ "."
}

as_additional_cost_to_cast_this_spell = {
    ^"as" ~ article ~ ^"additional" ~ ^"cost" ~ ^"to" ~ ^"cast"
  ~ ^"this" ~ ^"spell" ~ "," ~ spell_additional_cost ~ "."
}
spell_additional_cost = _{ sacrifice_permanent_cost }
sacrifice_permanent_cost = { ^"sacrifice" ~ article ~ permanent_type }

sacrifice_source_unless_you_pay = {
    trigger_then_prefix? ~ ^"sacrifice" ~ source_object ~ ^"unless"
  ~ ^"you" ~ ^"pay" ~ trigger_payment_cost ~ "."
}
trigger_then_prefix = { ^"then" }
trigger_payment_cost = _{ mana_cost_for_each_named_counter_on_it | mana_cost }
mana_cost_for_each_named_counter_on_it = {
    mana_cost ~ ^"for" ~ ^"each" ~ named_counter ~ ^"on" ~ ^"it"
}

sacrifice_source_effect = {
    ^"sacrifice" ~ source_object ~ "."
}

sacrifice_that_many_nontoken_permanents = {
    ^"sacrifice" ~ ^"that" ~ ^"many" ~ ^"nontoken" ~ ^"permanents" ~ "."
}

you_lose_the_game = { ^"you" ~ ^"lose" ~ ^"the" ~ ^"game" ~ "." }

you_gain_life = { ^"you" ~ ^"gain" ~ unsigned_number ~ ^"life" ~ "." }

player_may_pay_mana = {
    pay_mana_player ~ ^"may" ~ ^"pay" ~ pay_mana_amount ~ "."
}
pay_mana_player = _{ you_pay_mana_player | that_player_pay_mana_player }
you_pay_mana_player = { ^"you" }
that_player_pay_mana_player = { ^"that" ~ ^"player" }
pay_mana_amount = _{ any_amount_of_mana | mana_cost }
any_amount_of_mana = { ^"any" ~ ^"amount" ~ ^"of" ~ ^"mana" }
you_may_pay_mana = _{ player_may_pay_mana }
you_may_draw_cards = {
    ^"you" ~ ^"may" ~ activated_draw_cards
}
you_may_have_source_become_copy_of_target = {
    you_may_have_source_become_copy_of_target_fragment ~ "."
}
you_may_have_source_become_copy_of_target_fragment = {
    ^"you" ~ ^"may" ~ ^"have" ~ source_object ~ ^"become"
  ~ article ~ ^"copy" ~ ^"of" ~ ^"target" ~ permanent_type
  ~ copy_exception
}
tap_enchanted_object = { ^"tap" ~ ^"enchanted" ~ enchanted_object ~ "." }
you_may_put_this_card_onto_the_battlefield = {
    ^"you" ~ ^"may" ~ ^"put" ~ ^"this" ~ ^"card" ~ ^"onto"
  ~ ^"the" ~ ^"battlefield" ~ "."
}
if_you_do_gain_life_fragment = {
    ^"if" ~ ^"you" ~ ^"do" ~ "," ~ ^"you" ~ ^"gain" ~ unsigned_number ~ ^"life"
}

if_you_cant_source_deals_damage_to_you = {
    ^"if" ~ ^"you" ~ ^"can't" ~ "," ~ source_object ~ ^"deals"
  ~ damage_amount ~ ^"damage" ~ ^"to" ~ ^"you" ~ "."
}

if_you_flip_result_effect = {
    ^"if" ~ ^"you" ~ coin_flip_result ~ ^"the" ~ ^"flip" ~ "," ~ activated_effect
}
coin_flip_result = { ^"win" | ^"lose" }

only_sources_owner_may_activate_this_ability = {
    ^"only" ~ source_object_possessive ~ ^"owner" ~ ^"may" ~ ^"activate"
  ~ ^"this" ~ ^"ability" ~ "."
}
source_object_possessive = { ^"this" ~ source_object_kind ~ ("'s" | "s")? }

unless_you_pay_mana_do_actions = {
    ^"unless" ~ ^"you" ~ ^"pay" ~ mana_cost ~ ","
  ~ imperative_action ~ (^"and" ~ imperative_action)* ~ "."
}

remove_pt_counter_from_it = {
    ^"remove" ~ article ~ pt_counter ~ ^"from" ~ ^"it" ~ "."
}
put_pt_counter_on_it = {
    ^"put" ~ article ~ pt_counter ~ ^"on" ~ trigger_counter_recipient ~ "."
}
trigger_counter_recipient = { it_counter_recipient | source_counter_recipient }
it_counter_recipient = { ^"it" }
source_counter_recipient = { source_object }
put_named_counters_on_source = _{
    one_named_counter_on_source
  | that_many_named_counters
  | one_named_counter_for_each_permanent_died_this_turn
}
one_named_counter_on_source = {
    ^"put" ~ article ~ named_counter ~ ^"on" ~ source_object
  ~ trigger_counter_placement_terminator
}
trigger_counter_placement_terminator = _{ "." | "," }
that_many_named_counters = {
    ^"put" ~ ^"that" ~ ^"many" ~ named_counters ~ ^"on" ~ source_object ~ "."
}
one_named_counter_for_each_permanent_died_this_turn = {
    ^"put" ~ article ~ named_counter ~ ^"on" ~ source_object
  ~ ^"for" ~ ^"each" ~ permanent_type ~ ^"that" ~ ^"died"
  ~ ^"this" ~ ^"turn" ~ "."
}
you_may_remove_named_counter_from_source = {
    ^"you" ~ ^"may" ~ ^"remove" ~ article ~ named_counter ~ ^"from" ~ source_object ~ "."
}
player_loses_life = {
    life_loss_player ~ ^"loses" ~ life_loss_amount ~ ^"life"
  ~ ("," ~ rounding)? ~ "."
}
life_loss_player = _{ its_owner_life_loss_player }
its_owner_life_loss_player = { ^"its" ~ ^"owner" }
life_loss_amount = _{ half_their_life_loss_amount | unsigned_number }
half_their_life_loss_amount = { ^"half" ~ ^"their" }
delayed_remove_all_named_counters_from_linked_land = {
    ^"at" ~ ^"the" ~ ^"beginning" ~ ^"of" ~ ^"each" ~ ^"of" ~ ^"your"
  ~ ^"upkeeps" ~ ^"for" ~ ^"the" ~ ^"rest" ~ ^"of" ~ ^"the" ~ ^"game"
  ~ "," ~ ^"remove" ~ ^"all" ~ named_counters ~ ^"from" ~ article
  ~ permanent_type ~ ^"that" ~ article ~ named_counter ~ ^"was" ~ ^"put"
  ~ ^"onto" ~ ^"with" ~ source_object ~ ^"but" ~ ^"that" ~ article
  ~ named_counter ~ ^"has" ~ ^"not" ~ ^"been" ~ ^"removed" ~ ^"from"
  ~ ^"with" ~ source_object ~ "."
}

source_deals_damage = {
    trigger_damage_event ~ trigger_damage_condition?
  ~ trigger_damage_variable_definition? ~ trigger_damage_terminator
}
trigger_damage_event = {
    trigger_damage_source ~ ^"deals" ~ trigger_damage_body
}
trigger_damage_body = _{
    trigger_damage_amount ~ ^"damage" ~ ^"to" ~ trigger_damage_recipient
  | ^"damage" ~ trigger_damage_equal_to_amount ~ ^"to" ~ trigger_damage_recipient
  | ^"damage" ~ ^"to" ~ trigger_damage_recipient ~ trigger_damage_equal_to_amount
}
trigger_damage_terminator = _{ "." | &(^"and") }
trigger_damage_source = _{ it_damage_source | source_object }
it_damage_source = { ^"it" }
trigger_damage_amount = { damage_amount_expression }
trigger_damage_equal_to_amount = {
    ^"equal" ~ ^"to" ~ (
      that_permanents_toughness
    | ^"the" ~ ^"number" ~ ^"of" ~ basic_land_type_plural ~ ^"they" ~ ^"control"
    )
}
trigger_damage_recipient = _{
    that_permanents_controller
  | the_permanents_controller
  | that_player_damage_recipient
  | you_damage_recipient
  | that_permanent_damage_recipient
}
that_player_damage_recipient = { ^"that" ~ ^"player" }
you_damage_recipient = { ^"you" }
that_permanent_damage_recipient = { ^"that" ~ permanent_type }
trigger_damage_condition = {
    ^"unless" ~ ^"you" ~ ^"pay" ~ mana_cost
}
trigger_damage_variable_definition = {
    "," ~ where_clause
}
if_you_pay_source_deals_damage = {
    ^"if" ~ ^"you" ~ ^"pay" ~ "," ~ source_object ~ ^"deals"
  ~ ^"damage" ~ named_counter_count_on_it ~ ^"to" ~ damage_recipient
  ~ (^"and" ~ damage_recipient)* ~ "."
}
named_counter_count_on_it = {
    ^"equal" ~ ^"to" ~ ^"the" ~ ^"number" ~ ^"of" ~ named_counters
  ~ ^"on" ~ ^"it"
}
that_player_adds_mana_of_any_type_that_permanent_produced = {
    ^"that" ~ ^"player" ~ ^"adds" ~ number_word ~ ^"mana" ~ ^"of"
  ~ ^"any" ~ ^"type" ~ ^"that" ~ permanent_type ~ ^"produced" ~ "."
}
that_player_draws_an_additional_card = {
    ^"that" ~ ^"player" ~ ^"draws" ~ article ~ ^"additional" ~ ^"card" ~ "."
}
that_player_discards_card_at_random = {
  that_player_discard_prefix ~ discard_one_card ~ discard_at_random ~ "."
}
its_controller_adds_an_additional_mana = {
    ^"its" ~ ^"controller" ~ ^"adds" ~ article ~ ^"additional" ~ mana_symbol ~ "."
}
source_object = { "CARDNAME" | (^"this" ~ source_object_kind) | (^"that" ~ ^"source") }
source_object_kind = _{ aura_source_object | permanent_object | permanent_type }
aura_source_object = { ^"aura" }
permanent_object = { ^"permanent" }
that_permanents_controller = { ^"that" ~ permanent_type ~ "'s" ~ ^"controller" }
that_permanents_controller_may_attach_this_aura_to_permanent_of_their_choice = {
    that_permanents_controller ~ ^"may" ~ ^"attach" ~ ^"this" ~ ^"aura"
  ~ ^"to" ~ article ~ permanent_type ~ ^"of" ~ ^"their" ~ ^"choice" ~ "."
}
that_permanents_toughness = { ^"that" ~ permanent_type ~ "'s" ~ ^"toughness" }
the_permanents_controller = { ^"the" ~ permanent_type ~ "'s" ~ ^"controller" }
damage_amount_expression = _{ damage_dealt_to_you_this_turn | unsigned_number | variable_name }
damage_dealt_to_you_this_turn = {
    ^"damage" ~ ^"dealt" ~ ^"to" ~ ^"you" ~ ^"this" ~ ^"turn"
}
damage_amount = @{ ASCII_DIGIT+ }

// `it loses "<keyword>" and gains "<keyword>."`. The quoted strings are
// themselves keyword abilities — recursive parsing keeps them in the
// AST as full `Keyword` nodes rather than opaque text. Magic prints
// the closing period of the second quoted keyword INSIDE its quotes
// (e.g. `gains "enchant ... with this Aura."`), so this effect ends
// at the second closing quote — no period is emitted afterwards.
loses_and_gains_keyword = {
    ^"it" ~ ^"loses" ~ quoted_keyword
  ~ ^"and" ~ ^"gains" ~ quoted_keyword_with_inner_period
}
quoted_keyword                   = _{ "\"" ~ keyword ~ "\"" }
quoted_keyword_with_inner_period = _{ "\"" ~ keyword ~ "." ~ "\"" }
source_gains_static_ability      = { source_object ~ ^"gains" ~ quoted_static_ability }
quoted_static_ability            = _{ "\"" ~ static_enchanted_loses_keyword ~ "\"" }
quoted_triggered_ability         = _{ "\"" ~ triggered_ability ~ "\"" }

// "Return enchanted <type> card to the battlefield under your control
// and attach this Aura to it."
return_enchanted_card_and_attach = {
    ^"return" ~ ^"enchanted" ~ permanent_type ~ ^"card"
  ~ ^"to" ~ ^"the" ~ ^"battlefield" ~ ^"under" ~ ^"your" ~ ^"control"
  ~ ^"and" ~ ^"attach" ~ ^"this" ~ ^"aura" ~ ^"to" ~ ^"it" ~ "."
}

// Silent: the indefinite article ("a" / "an") is recoverable from
// the following noun's initial sound at unparse time, so we don't
// store it in the AST. "an" is listed first because PEG alternatives
// are ordered and "a" is a prefix of "an".
article = _{ ^"an" | ^"a" }
