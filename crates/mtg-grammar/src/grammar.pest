  ~ ^"on" ~ ^"the" ~ ^"battlefield"
  ~ (copy_exception_with_quoted_triggered_ability | copy_exception? ~ ".")
}

static_source_enters_tapped = {
    source_object ~ ^"enters" ~ ^"tapped" ~ "."
}

static_you_have_no_maximum_hand_size = {
    ^"you" ~ ^"have" ~ ^"no" ~ ^"maximum" ~ ^"hand" ~ ^"size" ~ "."
}

static_if_effect_causes_you_to_discard_card_you_may_put_it_on_top_of_library_instead = {
    ^"if" ~ article ~ ^"effect" ~ ^"causes" ~ ^"you" ~ ^"to" ~ ^"discard"
  ~ article ~ ^"card" ~ "," ~ ^"discard" ~ ^"it" ~ "," ~ ^"but"
  ~ ^"you" ~ ^"may" ~ ^"put" ~ ^"it" ~ ^"on" ~ ^"top" ~ ^"of"
  ~ ^"your" ~ ^"library" ~ ^"instead" ~ ^"of" ~ ^"into" ~ ^"your"
  ~ ^"graveyard" ~ "."
}

