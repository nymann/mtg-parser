}

static_source_cant_be_blocked_by_creature_type = {
    source_object ~ ^"can't" ~ ^"be" ~ ^"blocked" ~ ^"by" ~ creature_type_plural ~ "."
}

static_basic_lands_are_basic_lands = {
    ^"all" ~ basic_land_type_plural ~ ^"are" ~ basic_land_type_plural ~ "."
}

static_basic_lands_are_pt_colored_creatures_still_lands = {
    ^"all" ~ basic_land_type_plural ~ ^"are" ~ unsigned_number ~ "/" ~ unsigned_number
  ~ color_word? ~ ^"creatures" ~ ^"that" ~ ^"are" ~ ^"still" ~ ^"lands" ~ "."
}

static_that_permanent_is_basic_land_type_while_has_named_counter = {
    ^"that" ~ permanent_type ~ ^"is" ~ article ~ basic_land_type
  ~ ^"for" ~ ^"as" ~ ^"long" ~ ^"as" ~ ^"it" ~ ^"has"
  ~ article ~ named_counter ~ ^"on" ~ ^"it" ~ "."
}

static_source_doesnt_untap_during_your_untap_step = {
    (source_object ~ ^"doesn't" ~ ^"untap" ~ ^"during" ~ ^"your"
      ~ ^"untap" ~ ^"step" ~ ".")
  | (^"enchanted" ~ enchanted_object ~ ^"doesn't" ~ ^"untap" ~ ^"during"
      ~ ^"its" ~ ^"controller's" ~ ^"untap" ~ ^"step" ~ ".")
}

static_creatures_with_power_or_greater_dont_untap_during_their_controllers_untap_steps = {
    static_untap_restriction_during_untap_steps ~ "."
}

static_untap_restriction_during_untap_steps = {
    (^"creatures" ~ ^"with" ~ ^"power" ~ unsigned_number ~ ^"or" ~ ^"greater"
    ~ ^"don't" ~ ^"untap" ~ ^"during" ~ ^"their" ~ ^"controllers'"
    ~ ^"untap" ~ ^"steps")
  | (^"players" ~ ^"can't" ~ ^"untap" ~ ^"more" ~ ^"than" ~ number_word
    ~ permanent_type ~ ^"during" ~ ^"their" ~ ^"untap" ~ ^"steps")
  | (^"players" ~ ^"skip" ~ ^"their" ~ ^"untap" ~ ^"steps")
}

static_source_cant_block_creatures_with_power_or_greater = {
